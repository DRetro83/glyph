// Glyph - taskbar (step 2). Colours come from style.css, made by glyph-theme.
{
  "layer": "top",
  "position": "bottom",
  "height": 46,
  "spacing": 0,
  "modules-left": ["custom/start", "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "wlr/taskbar"],
  "modules-right": ["tray", "custom/windows", "custom/settings", "clock", "custom/power"],

  "custom/start": {
    "format": "▸ START",
    "tooltip-format": "Start menu (Super or Ctrl+Space)",
    "on-click": "glyph-menu"
  },

  // workspaces: click to go there; the current one is lit (glyph-ws keeps track)
  "custom/ws1": { "exec": "glyph-ws state 1", "return-type": "json", "interval": "once", "signal": 8, "on-click": "glyph-ws 1" },
  "custom/ws2": { "exec": "glyph-ws state 2", "return-type": "json", "interval": "once", "signal": 8, "on-click": "glyph-ws 2" },
  "custom/ws3": { "exec": "glyph-ws state 3", "return-type": "json", "interval": "once", "signal": 8, "on-click": "glyph-ws 3" },
  "custom/ws4": { "exec": "glyph-ws state 4", "return-type": "json", "interval": "once", "signal": 8, "on-click": "glyph-ws 4" },

  // open windows: a letter tile and the name, no icons
  "wlr/taskbar": {
    "format": "{icon}  {title}",
    "icon-theme": "GlyphLetters",
    "icon-size": 22,
    "rewrite": {
      ".* - Files": "  Files", ".* - Music": "  Music", ".* - Thunar": "  Thunar", "\\s*Thunar": "  Thunar", ".* - Mousepad": "  Text editor", "\\s*Mousepad": "  Text editor",
      ".*Mozilla Firefox.*": "  Firefox", ".* — Firefox.*": "  Firefox", ".*Vivaldi.*": "  Vivaldi",
      "\\s*Settings": "  Settings", "\\s*foot": "  Terminal", ".*@.*:.*": "  Terminal",
      "^\\s*(.{0,20}).*$": "  $1"
    },
    "tooltip-format": "{title}",
    "on-click": "minimize-raise",
    "on-click-middle": "close",
    "on-click-right": "maximize",
    "ignore-list": ["waybar"]
  },

  "tray": { "icon-size": 16, "spacing": 8 },

  // quick settings: Wi-Fi, Bluetooth, volume, brightness, power, drives
  "custom/windows": {
    "exec": "glyph-windows", "return-type": "json", "interval": 3,
    "on-click": "glyph-panel windows"
  },
  "custom/settings": {
    "exec": "glyph-panel status",
    "return-type": "json",
    "interval": 5,
    "on-click": "glyph-panel quick",
    "on-scroll-up": "glyph-volume up",
    "on-scroll-down": "glyph-volume down"
  },

  "wireplumber": {
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "tooltip-format": "{node_name}\nScroll: volume · Click: mute",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "max-volume": 100
  },

  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "NET wired",
    "format-linked": "NET no IP",
    "format-disconnected": "NET off",
    "tooltip-format-wifi": "{essid} · signal {signalStrength}%\n{ipaddr}\nClick: choose a network",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "max-length": 22,
    "on-click": "foot -T Wi-Fi nmtui"
  },

  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}% +",
    "format-plugged": "BAT {capacity}% +",
    "states": { "warning": 20, "critical": 10 },
    "tooltip-format": "{timeTo}"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}",
    "on-click": "glyph-panel cal"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Lock, log out, restart, shut down",
    "on-click": "glyph-power"
  }
}
