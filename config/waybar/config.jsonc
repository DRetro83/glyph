// Glyph - taskbar (step 2). Colours come from style.css, made by glyph-theme.
{
  "layer": "top",
  "reload_style_on_change": true,
  "position": "bottom",
  "height": 46,
  "spacing": 0,
  "modules-left": ["custom/start", "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/task1", "custom/task2", "custom/task3", "custom/task4", "custom/task5", "custom/task6", "custom/task7", "custom/task8", "custom/task9", "custom/task10", "custom/task11", "custom/task12"],
  "modules-right": ["custom/media", "tray", "custom/windows", "custom/settings", "clock", "custom/power"],

  "custom/start": {
    "format": "▸ START",
    "tooltip-format": "Start menu (Super or Ctrl+Space)",
    "on-click": "glyph-menu"
  },

  // workspaces: click to go there; the current one is lit (glyph-ws keeps track)
  "custom/ws1": { "exec": "glyph-ws state 1", "return-type": "json", "interval": "once", "signal": 8, "on-click": "glyph-ws 1" },
  "custom/ws2": { "exec": "glyph-ws state 2", "return-type": "json", "interval": "once", "signal": 8, "on-click": "glyph-ws 2" },
  "custom/ws3": { "exec": "glyph-ws state 3", "return-type": "json", "interval": "once", "signal": 8, "on-click": "glyph-ws 3" },
  "custom/ws4": { "exec": "glyph-ws state 4", "return-type": "json", "interval": "once", "signal": 8, "on-click": "glyph-ws 4" },

  // open apps of every workspace: a letter tile in the colour of its workspace (glyph-tasks)
  "custom/task1": { "exec": "glyph-tasks slot 1", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 1", "on-click-middle": "glyph-tasks close 1" },
  "custom/task2": { "exec": "glyph-tasks slot 2", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 2", "on-click-middle": "glyph-tasks close 2" },
  "custom/task3": { "exec": "glyph-tasks slot 3", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 3", "on-click-middle": "glyph-tasks close 3" },
  "custom/task4": { "exec": "glyph-tasks slot 4", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 4", "on-click-middle": "glyph-tasks close 4" },
  "custom/task5": { "exec": "glyph-tasks slot 5", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 5", "on-click-middle": "glyph-tasks close 5" },
  "custom/task6": { "exec": "glyph-tasks slot 6", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 6", "on-click-middle": "glyph-tasks close 6" },
  "custom/task7": { "exec": "glyph-tasks slot 7", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 7", "on-click-middle": "glyph-tasks close 7" },
  "custom/task8": { "exec": "glyph-tasks slot 8", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 8", "on-click-middle": "glyph-tasks close 8" },
  "custom/task9": { "exec": "glyph-tasks slot 9", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 9", "on-click-middle": "glyph-tasks close 9" },
  "custom/task10": { "exec": "glyph-tasks slot 10", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 10", "on-click-middle": "glyph-tasks close 10" },
  "custom/task11": { "exec": "glyph-tasks slot 11", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 11", "on-click-middle": "glyph-tasks close 11" },
  "custom/task12": { "exec": "glyph-tasks slot 12", "return-type": "json", "interval": "once", "signal": 9, "escape": false, "on-click": "glyph-tasks click 12", "on-click-middle": "glyph-tasks close 12" },

  "tray": { "icon-size": 16, "spacing": 8 },

  // quick settings: Wi-Fi, Bluetooth, volume, brightness, power, drives
  "custom/media": {
    "exec": "glyph-panel media-status", "return-type": "json", "interval": 2,
    "on-click": "glyph-panel media",
    "on-click-middle": "playerctl play-pause",
    "on-scroll-up": "playerctl next", "on-scroll-down": "playerctl previous"
  },
  "custom/windows": {
    "exec": "glyph-windows", "return-type": "json", "interval": 3,
    "on-click": "glyph-panel windows"
  },
  "custom/settings": {
    "exec": "glyph-panel status",
    "return-type": "json",
    "interval": 5,
    "on-click": "glyph-panel quick",
    "on-scroll-up": "glyph-volume up",
    "on-scroll-down": "glyph-volume down"
  },

  "wireplumber": {
    "format": "VOL {volume}%",
    "format-muted": "VOL muted",
    "tooltip-format": "{node_name}\nScroll: volume · Click: mute",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "scroll-step": 5,
    "max-volume": 100
  },

  "network": {
    "format-wifi": "NET {essid}",
    "format-ethernet": "NET wired",
    "format-linked": "NET no IP",
    "format-disconnected": "NET off",
    "tooltip-format-wifi": "{essid} · signal {signalStrength}%\n{ipaddr}\nClick: choose a network",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "max-length": 22,
    "on-click": "foot -T Wi-Fi nmtui"
  },

  "battery": {
    "format": "BAT {capacity}%",
    "format-charging": "BAT {capacity}% +",
    "format-plugged": "BAT {capacity}% +",
    "states": { "warning": 20, "critical": 10 },
    "tooltip-format": "{timeTo}"
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}",
    "on-click": "glyph-panel cal"
  },

  "custom/power": {
    "format": "⏻",
    "tooltip-format": "Lock, log out, restart, shut down",
    "on-click": "glyph-power"
  }
}
