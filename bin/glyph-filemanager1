#!/usr/bin/env python3
"""glyph-filemanager1 - answer "show in folder" requests with Glyph Files.

Browsers (Vivaldi, Chrome, Firefox) and other apps ask the D-Bus service
org.freedesktop.FileManager1 to show a downloaded file. On a system with KDE
that starts Dolphin. In the Glyph session this small service takes the name
first and opens Glyph Files instead, with the file selected.
Started from the session's autostart.
"""
import subprocess
from urllib.parse import unquote, urlparse

from gi.repository import Gio, GLib

XML = """<node><interface name="org.freedesktop.FileManager1">
  <method name="ShowFolders"><arg type="as" name="URIs" direction="in"/><arg type="s" name="StartupId" direction="in"/></method>
  <method name="ShowItems"><arg type="as" name="URIs" direction="in"/><arg type="s" name="StartupId" direction="in"/></method>
  <method name="ShowItemProperties"><arg type="as" name="URIs" direction="in"/><arg type="s" name="StartupId" direction="in"/></method>
</interface></node>"""


def path(uri):
    u = urlparse(uri)
    return unquote(u.path) if u.scheme in ("file", "") else uri


def call(conn, sender, obj, iface, method, params, inv):
    uris = params.unpack()[0]
    if uris:
        # one window per folder; for files, glyph-files opens the folder and selects the file
        subprocess.Popen(["glyph-files", *[path(u) for u in uris[:8]]], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    inv.return_value(None)


def on_bus(conn, name):
    info = Gio.DBusNodeInfo.new_for_xml(XML).interfaces[0]
    conn.register_object("/org/freedesktop/FileManager1", info, call, None, None)


Gio.bus_own_name(Gio.BusType.SESSION, "org.freedesktop.FileManager1",
                 Gio.BusNameOwnerFlags.REPLACE | Gio.BusNameOwnerFlags.ALLOW_REPLACEMENT,
                 on_bus, None, lambda *a: None)
GLib.MainLoop().run()
