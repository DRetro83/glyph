#!/usr/bin/env python3
"""glyph-watch - small helpers that run in the background of the Glyph session.

USB   a drive plugged in: a sound and a message with "Open"; taken out: a sound.
BATT  battery low (15 %): a message; very low (10 %): an urgent message and a beep;
      5 % and not charging: the computer goes to sleep after a minute, so nothing is lost.
Started from the session's autostart.
"""
import os
import subprocess
import threading
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib  # noqa: E402

# Glyph in your language (Settings -> Language & region): see glyph_lang.py
try:
    import sys
    sys.path[:0] = ["/usr/local/lib/glyph", "/usr/lib/glyph", os.path.dirname(os.path.realpath(__file__))]
    import glyph_lang
    glyph_lang.load()
    _ = glyph_lang.tr
except Exception:
    def _(s):
        return s


def session_over():
    """True when the Glyph session has ended (its Wayland socket is gone): then this helper stops too,
    so nothing of Glyph keeps running after you sign out (and KDE gets Dolphin back for "show in folder")."""
    name = os.environ.get("WAYLAND_DISPLAY", "")
    if not name:
        return False
    path = name if name.startswith("/") else os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), name)
    return not os.path.exists(path)


def bg(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def notify(title, body, urgency="normal", actions=(), on_action=None):
    """notify-send with buttons; waits for the answer in a thread."""
    cmd = ["notify-send", "-a", "Glyph", "-u", urgency]
    for key, text in actions:
        cmd += ["-A", f"{key}={_(text)}"]
    cmd += [title, body]

    def work():
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=600).stdout.strip()
        except Exception:
            out = ""
        if out and on_action:
            GLib.idle_add(on_action, out)
    threading.Thread(target=work, daemon=True).start()


# ---------------------------------------------------------------- USB drives
class Usb:
    def __init__(self):
        self.mon = Gio.VolumeMonitor.get()
        self.mon.connect("volume-added", self.added)
        self.mon.connect("volume-removed", self.removed)

    def added(self, mon, vol):
        name = vol.get_name() or _("USB drive")
        bg(["glyph-sound", "plug"])

        def act(key):
            if key == "open":
                self.open(vol)
            return False
        notify("USB · " + name, _("Plugged in."), actions=(("open", "Open"),), on_action=act)

    def open(self, vol):
        m = vol.get_mount()
        if m:
            bg(["glyph-files", m.get_root().get_path()])
            return

        def done(v, res):
            try:
                v.mount_finish(res)
                mm = v.get_mount()
                if mm:
                    bg(["glyph-files", mm.get_root().get_path()])
            except Exception as e:
                notify("USB", _("Could not open it") + f": {e}")
        vol.mount(Gio.MountMountFlags.NONE, None, None, done)

    def removed(self, mon, vol):
        bg(["glyph-sound", "unplug"])
        notify("USB · " + (vol.get_name() or _("drive")), _("Taken out."))


# ---------------------------------------------------------------- updates
class Updates:
    """A few times a day: how many updates are ready (Debian refreshes its lists by itself
    every day). The number shows on the SETTINGS button; a message when there are new ones."""
    FILE = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "glyph-updates"

    def __init__(self):
        self.told = 0
        GLib.timeout_add_seconds(120, lambda: (self.check(), False)[1])     # 2 minutes after sign-in
        GLib.timeout_add_seconds(6 * 3600, lambda: (self.check(), True)[1])

    def check(self):
        threading.Thread(target=self.work, daemon=True).start()

    def work(self):
        n = 0
        try:
            out = subprocess.run(["apt", "list", "--upgradable"], capture_output=True, text=True, timeout=60).stdout
            n += sum(1 for l in out.splitlines() if "[upgradable from" in l)
        except Exception:
            pass
        try:
            out = subprocess.run(["flatpak", "remote-ls", "--updates", "--columns=application"],
                                 capture_output=True, text=True, timeout=120).stdout
            n += len([l for l in out.splitlines() if l.strip()])
        except Exception:
            pass
        GLib.idle_add(self.done, n)

    def done(self, n):
        try:
            self.FILE.write_text(f"{n}\n")
        except Exception:
            pass
        bg(["pkill", "-RTMIN+10", "-u", str(os.getuid()), "-x", "waybar"])
        if n > self.told:

            def act(key):
                if key == "open":
                    bg(["glyph-software", "updates"])
                return False
            notify(_("Updates"), _("{n} updates are ready.").replace("{n}", str(n)), actions=(("open", "Update now"),), on_action=act)
        self.told = n
        return False


# ---------------------------------------------------------------- battery
class Battery:
    def __init__(self):
        self.warned = 100
        self.sleep_timer = None
        self.bats = [p for p in Path("/sys/class/power_supply").glob("BAT*")]
        if self.bats:
            GLib.timeout_add_seconds(60, self.check)
            GLib.timeout_add_seconds(5, lambda: (self.check(), False)[1])

    def read(self):
        """Charge of all batteries together (a laptop can have two), and whether it is plugged in."""
        now = full = 0.0
        pct, charging = [], False
        for b in self.bats:
            try:
                pct.append(int((b / "capacity").read_text()))
                if (b / "status").read_text().strip() in ("Charging", "Full", "Not charging"):
                    charging = True
                for a, z in (("energy_now", "energy_full"), ("charge_now", "charge_full")):
                    if (b / a).exists() and (b / z).exists():
                        now += float((b / a).read_text())
                        full += float((b / z).read_text())
                        break
            except Exception:
                pass
        if full > 0 and len(pct) > 1:
            return round(100 * now / full), charging
        return (min(pct) if pct else None), charging

    def check(self):
        pct, charging = self.read()
        if pct is None:
            return True
        if charging:
            self.warned = 100
            if self.sleep_timer:
                GLib.source_remove(self.sleep_timer)
                self.sleep_timer = None
                notify(_("Battery"), _("Charging. The computer stays on."))
            return True
        if pct <= 5 and not self.sleep_timer:
            bg(["glyph-sound", "error"])
            notify(_("Battery almost empty"), f"{pct} %. " + _("The computer goes to sleep in 1 minute. Plug in the charger to stop it."),
                   "critical")
            self.sleep_timer = GLib.timeout_add_seconds(60, self.sleep)
        elif pct <= 10 and self.warned > 10:
            self.warned = 10
            bg(["glyph-sound", "error"])
            notify(_("Battery very low"), f"{pct} % " + _("left. Plug in the charger soon."), "critical")
        elif pct <= 15 and self.warned > 15:
            self.warned = 15
            notify(_("Battery low"), f"{pct} % " + _("left."))
        return True

    def sleep(self):
        self.sleep_timer = None
        pct, charging = self.read()
        if not charging:
            bg(["sh", "-c", "glyph-lock; sleep 1; systemctl suspend"])
        return False


def main():
    try:
        os.setsid()
    except Exception:
        pass
    Usb()
    Battery()
    Updates()
    loop = GLib.MainLoop()
    GLib.timeout_add_seconds(10, lambda: (loop.quit(), False)[1] if session_over() else True)
    loop.run()


if __name__ == "__main__":
    main()
