#!/bin/sh
# glyph-menu - open or close the Glyph start menu.
# Falls back to the simple fuzzel menu when glyph-start cannot run.
if python3 -c 'import gi; gi.require_version("GtkLayerShell", "0.1")' 2>/dev/null; then
  exec glyph-start "$@"
fi
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/glyph/fuzzel/fuzzel.ini"
if pkill -u "$(id -u)" -x fuzzel 2>/dev/null; then exit 0; fi
exec fuzzel --config="$CONF" "$@"
