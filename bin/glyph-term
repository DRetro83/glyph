#!/bin/sh
# glyph-term [FOLDER] - open your terminal (Settings -> Default apps -> Terminal).
# Standard: xfce4-terminal (right-click menu, Glyph colours); foot as a light fallback.
T=$(sed -n 's/^terminal=//p' "${XDG_CONFIG_HOME:-$HOME/.config}/glyph/glyph.conf" 2>/dev/null)
command -v "$T" >/dev/null 2>&1 || T=""
[ -z "$T" ] && command -v xfce4-terminal >/dev/null 2>&1 && T=xfce4-terminal
[ -z "$T" ] && T=foot
D="$1"
case "$T" in
  xfce4-terminal) [ -n "$D" ] && exec xfce4-terminal --working-directory="$D"; exec xfce4-terminal ;;
  foot)           [ -n "$D" ] && exec foot -D "$D"; exec foot ;;
  kitty)          [ -n "$D" ] && exec kitty -d "$D"; exec kitty ;;
  alacritty)      [ -n "$D" ] && exec alacritty --working-directory "$D"; exec alacritty ;;
  konsole)        [ -n "$D" ] && exec konsole --workdir "$D"; exec konsole ;;
  *)              [ -n "$D" ] && cd "$D"; exec "$T" ;;
esac
