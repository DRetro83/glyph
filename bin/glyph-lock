#!/bin/sh
# glyph-lock - lock the screen in the Glyph look (like the prototype:
# LOCKED, a big clock, the date, and "password, then Enter  UNLOCK ▸").
# Uses gtklock; falls back to swaylock (only a ring) when gtklock is missing.
G="${XDG_CONFIG_HOME:-$HOME/.config}/glyph"
pgrep -u "$(id -u)" -x gtklock >/dev/null && exit 0   # (only your own: another user may be locked too)
pgrep -u "$(id -u)" -x swaylock >/dev/null && exit 0
if command -v gtklock >/dev/null; then
  [ -f "$G/gtklock/layout.ui" ] || glyph-theme >/dev/null 2>&1
  # music controls on the lock screen: only when you turned them on (Settings -> Power & lock),
  # so by default nobody sees what is playing (a YouTube title, for example)
  M=""
  grep -q '^lock_media=yes' "$G/glyph.conf" 2>/dev/null && for f in /usr/lib/*/gtklock/playerctl-module.so /usr/lib/gtklock/playerctl-module.so /usr/local/lib/*/gtklock/playerctl-module.so; do
    [ -f "$f" ] && M="$f" && break
  done
  exec gtklock -d -s "$G/gtklock/style.css" -x "$G/gtklock/layout.ui" \
    -t "%H:%M" -D "%A %d %B %Y" ${M:+-m "$M"} "$@"
fi
exec swaylock -f -C "$G/swaylock/config"
