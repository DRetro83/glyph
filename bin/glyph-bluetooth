#!/usr/bin/env python3
"""glyph-bluetooth - paired and nearby Bluetooth devices: search, pair, connect, forget.

Uses BlueZ (bluetoothctl). Refresh looks for nearby devices for 12 seconds.
"""
import os
import re
import subprocess
import threading
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

GLib.set_prgname("glyph-bluetooth")
CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "glyph"
KINDS = {"audio": "audio", "headset": "audio", "headphone": "audio", "speaker": "audio", "input-mouse": "mouse",
         "input-keyboard": "keyboard", "input-gaming": "controller", "input-tablet": "tablet", "phone": "phone",
         "computer": "computer", "video-display": "display", "printer": "printer", "camera": "camera"}


def bt(*args, timeout=15):
    try:
        r = subprocess.run(["bluetoothctl", *args], capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout + r.stderr
    except Exception as e:
        return 1, str(e)


def devices():
    """[{mac, name, paired, connected, kind, battery, rssi}]"""
    out = []
    _, lst = bt("devices")
    for l in lst.splitlines():
        m = re.match(r"Device ([0-9A-F:]{17}) (.*)", l.strip())
        if not m:
            continue
        mac, name = m.group(1), m.group(2)
        _, info = bt("info", mac, timeout=5)
        g = lambda k: (re.search(rf"^\s*{k}: (.+)$", info, re.M) or [None, ""])[1].strip()
        icon = g("Icon")
        kind = next((v for k, v in KINDS.items() if k in icon), icon.split("-")[-1] if icon else "")
        bat = re.search(r"Battery Percentage: \S+ \((\d+)\)", info)
        rssi = g("RSSI")
        out.append({"mac": mac, "name": g("Alias") or name, "paired": g("Paired") == "yes",
                    "connected": g("Connected") == "yes", "kind": kind,
                    "battery": int(bat.group(1)) if bat else None,
                    "rssi": int(rssi.split()[0]) if rssi[:1] in "-0123456789" and rssi else None})
    return out


class Bars(Gtk.DrawingArea):
    def __init__(self, rssi, pal):
        super().__init__()
        self.rssi, self.pal = rssi, pal
        self.set_size_request(30, 18)
        self.connect("draw", self.draw)

    def draw(self, w, cr):
        r = self.rssi if self.rssi is not None else -60
        lit = 1 + (r > -85) + (r > -72) + (r > -60)
        c = lambda h: tuple(int(h.lstrip("#")[i:i + 2], 16) / 255 for i in (0, 2, 4))
        for i in range(4):
            cr.set_source_rgb(*c(self.pal.get("GLYPH_TEXT" if i < lit else "GLYPH_HI", "#888888")))
            h = 5 + i * 4
            cr.rectangle(i * 7, 18 - h, 6, h)
            cr.fill()
        return False


class Bluetooth(Gtk.Window):
    def __init__(self):
        super().__init__(title="Bluetooth")
        self.set_default_size(520, 600)
        self.pal = {}
        try:
            for l in (CONF / "palette.env").read_text().splitlines():
                if "=" in l:
                    k, v = l.split("=", 1)
                    self.pal[k] = v.strip()
        except Exception:
            pass
        css = Gtk.CssProvider()
        try:
            css.load_from_path(str(CONF / "panel" / "panel.css"))
        except Exception:
            pass
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.get_style_context().add_class("panel")
        root.get_style_context().add_class("netapp")
        self.add(root)
        top = Gtk.Box(spacing=6)
        top.get_style_context().add_class("ntop")
        self.power = Gtk.Button()
        self.power.connect("clicked", lambda *_: self.flip_power())
        top.pack_start(self.power, False, False, 0)
        self.b_ref = Gtk.Button(label="Refresh · look for devices")
        self.b_ref.connect("clicked", lambda *_: self.scan())
        top.pack_start(self.b_ref, True, True, 0)
        root.pack_start(top, False, False, 0)
        self.count = Gtk.Label(xalign=0)
        self.count.get_style_context().add_class("ncount")
        root.pack_start(self.count, False, False, 0)
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        sw.add(self.list)
        root.pack_start(sw, True, True, 0)
        self.devs, self.busy, self.msg, self.scanning, self.on = [], None, {}, False, True
        self.connect("key-press-event", lambda w, e: self.close() if e.keyval == Gdk.KEY_Escape else False)
        self.connect("destroy", lambda *_: subprocess.Popen(["bluetoothctl", "scan", "off"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        self.load()
        GLib.timeout_add_seconds(3, lambda: (self.load() if not self.busy and (self.scanning or self.tick()) else None, True)[1])

    def tick(self):
        """Outside a search, look again every 9 seconds only."""
        self.ticks = getattr(self, "ticks", 0) + 1
        return self.ticks % 3 == 0

    def load(self):
        def work():
            _, show = bt("show", timeout=5)
            on = "Powered: yes" in show
            devs = devices() if on else []
            GLib.idle_add(self.loaded, on, devs, "Controller" in show)
        threading.Thread(target=work, daemon=True).start()

    def loaded(self, on, devs, present):
        self.on, self.devs = on, devs
        self.present = present
        self.power.set_label("Bluetooth ON" if on else "Bluetooth OFF")
        (self.power.get_style_context().add_class if on else self.power.get_style_context().remove_class)("on")
        self.b_ref.set_sensitive(on and not self.scanning)
        self.b_ref.set_label("Looking for devices…" if self.scanning else "Refresh · look for devices")
        self.fill()
        return False

    def flip_power(self):
        subprocess.run(["bluetoothctl", "power", "off" if self.on else "on"], capture_output=True, timeout=10)
        self.load()

    def scan(self):
        self.scanning = True
        self.b_ref.set_sensitive(False)
        self.b_ref.set_label("Looking for devices…")

        def work():
            bt("--timeout", "12", "scan", "on", timeout=20)
            GLib.idle_add(lambda: (setattr(self, "scanning", False), self.load(), False)[2])
        threading.Thread(target=work, daemon=True).start()

    def fill(self):
        for c in self.list.get_children():
            self.list.remove(c)
        if not getattr(self, "present", True):
            self.count.set_text("No Bluetooth adapter found.")
            self.list.show_all()
            return
        if not self.on:
            self.count.set_text("Bluetooth is off. Click Bluetooth OFF to turn it on.")
            self.list.show_all()
            return
        paired = [d for d in self.devs if d["paired"]]
        near = [d for d in self.devs if not d["paired"]]
        self.count.set_text(f"{len(self.devs)} devices · {len(paired)} paired")
        self.list.pack_start(self.head("PAIRED"), False, False, 0)
        if not paired:
            self.list.pack_start(self.note("No paired devices yet."), False, False, 0)
        for d in sorted(paired, key=lambda d: (not d["connected"], d["name"].lower())):
            self.list.pack_start(self.row(d), False, False, 0)
        self.list.pack_start(self.head("NEARBY"), False, False, 0)
        if not near:
            self.list.pack_start(self.note("Click Refresh to look for devices. Put the device in pairing mode first."), False, False, 0)
        for d in sorted(near, key=lambda d: -(d["rssi"] or -200)):
            self.list.pack_start(self.row(d), False, False, 0)
        self.list.show_all()

    def head(self, t):
        l = Gtk.Label(label=t, xalign=0)
        l.get_style_context().add_class("lab")
        l.get_style_context().add_class("nhead")
        return l

    def note(self, t):
        l = Gtk.Label(label=t, xalign=0)
        l.set_line_wrap(True)
        l.get_style_context().add_class("ts")
        l.get_style_context().add_class("nnote")
        return l

    def row(self, d):
        r = Gtk.Box(spacing=10)
        r.get_style_context().add_class("nrow")
        t = Gtk.Label(label=(d["name"][:1] or "?").upper())
        t.get_style_context().add_class("tile")
        t.set_valign(Gtk.Align.CENTER)
        r.pack_start(t, False, False, 0)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        n = Gtk.Label(label=d["name"], xalign=0)
        n.set_ellipsize(3)
        n.get_style_context().add_class("tn")
        v.pack_start(n, False, False, 0)
        bits = ["✓ connected" if d["connected"] else "paired" if d["paired"] else "nearby · not paired"]
        if d["kind"]:
            bits.append(d["kind"])
        if d["battery"] is not None:
            bits.append(f"battery {d['battery']}%")
        sub = self.msg.get(d["mac"]) or " · ".join(bits)
        s = Gtk.Label(label=sub, xalign=0)
        s.set_ellipsize(3)
        s.get_style_context().add_class("ok" if d["connected"] else ("amber" if not d["paired"] else "ts"))
        v.pack_start(s, False, False, 0)
        r.pack_start(v, True, True, 0)
        if self.busy == d["mac"]:
            r.pack_end(self.lab("…"), False, False, 0)
            return r
        mac = d["mac"]
        if d["paired"]:
            if d["connected"]:
                r.pack_end(self.btn("Disconnect", lambda: self.run(d, [["disconnect", mac]])), False, False, 0)
            else:
                r.pack_end(self.btn("Connect", lambda: self.run(d, [["connect", mac]])), False, False, 0)
                r.pack_end(self.btn("Forget", lambda: self.run(d, [["remove", mac]])), False, False, 0)
        else:
            r.pack_end(self.btn("Pair", lambda: self.run(d, [["--agent", "NoInputNoOutput", "pair", mac], ["trust", mac], ["connect", mac]]), "amber"), False, False, 0)
        r.pack_end(Bars(d["rssi"], self.pal), False, False, 0)
        return r

    def lab(self, t):
        l = Gtk.Label(label=t)
        l.get_style_context().add_class("amber")
        return l

    def btn(self, t, cb, cls=""):
        b = Gtk.Button(label=t)
        b.get_style_context().add_class("nbtn")
        for c in cls.split():
            b.get_style_context().add_class(c)
        b.set_valign(Gtk.Align.CENTER)
        b.connect("clicked", lambda *_: cb())
        return b

    def run(self, d, steps):
        self.busy = d["mac"]
        self.msg.pop(d["mac"], None)
        self.fill()

        def work():
            ok, last = True, ""
            for st in steps:
                rc, out = bt(*st, timeout=30)
                last = out
                if rc != 0 or "Failed" in out or "not available" in out:
                    ok = False
                    break

            def done():
                self.busy = None
                if not ok:
                    line = [l for l in last.splitlines() if l.strip()][-1:] or ["?"]
                    self.msg[d["mac"]] = "did not work: " + line[0][:60]
                self.load()
                return False
            GLib.idle_add(done)
        threading.Thread(target=work, daemon=True).start()


if __name__ == "__main__":
    w = Bluetooth()
    w.connect("destroy", Gtk.main_quit)
    w.show_all()
    Gtk.main()
