#!/usr/bin/env python3
"""glyph-settings - the Glyph Settings window.

  glyph-settings              open on Appearance
  glyph-settings Sound        open on a section

Most pages change Glyph's own files (theme.conf, glyph.conf, labwc rc.xml).
Pages for system things (network, Bluetooth, date) use the standard Debian
tools and ask for your password where Debian needs it.
"""
import os
import re
import shutil
import subprocess
import sys
import time
from pathlib import Path

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, GLib, Gtk  # noqa: E402

# Glyph in your language (Settings -> Language & region): see glyph_lang.py
try:
    import sys as _sys
    _sys.path[:0] = ["/usr/local/lib/glyph", __import__("os").path.dirname(__import__("os").path.realpath(__file__))]
    import glyph_lang
    glyph_lang.hook_gtk()
    _ = glyph_lang.tr
except Exception:
    def _(s):
        return s

CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "glyph"
THEME = CONF / "theme.conf"
GCONF = CONF / "glyph.conf"
RCXML = CONF / "labwc" / "rc.xml"
ENVF = CONF / "labwc" / "environment"
COLOURS = [("Tan", "tan", "#a8957c"), ("Light tan", "light-tan", "#cdbb9f"), ("Cream", "cream", "#e6dac4"),
           ("Amber", "amber", "#ffb340"), ("Olive", "olive", "#b5b03c"), ("Green", "green", "#8c9e3a"),
           ("Rose", "rose", "#b8405c"), ("Blue", "blue", "#8fb0c8"), ("Dark blue", "dark-blue", "#4a6a8a"),
           ("Dark tan", "dark-tan", "#6e5f4c")]
LAYOUTS = [("us", "English (US)"), ("gb", "English (UK)"), ("be", "Belgian (AZERTY)"), ("fr", "French (AZERTY)"),
           ("de", "German (QWERTZ)"), ("nl", "Dutch"), ("es", "Spanish"), ("it", "Italian"), ("pt", "Portuguese")]
SECTIONS = [("PERSONAL", ["Appearance", "Background", "Taskbar", "Notifications"]),
            ("DEVICES", ["Display", "Sound", "Keyboard", "Mouse & touchpad", "Printers", "Power & lock", "Disks"]),
            ("CONNECTIONS", ["Network", "Mobile network", "Bluetooth"]),
            ("SYSTEM", ["Users", "Date & time", "Language & region", "Privacy", "Default apps", "Accessibility",
                        "Updates", "About"])]


def sh(cmd, timeout=5):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def bg(cmd):
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def has(p):
    return shutil.which(p) is not None


def read_kv(path):
    d = {}
    try:
        for l in path.read_text().splitlines():
            if "=" in l and not l.lstrip().startswith("#"):
                k, v = l.split("=", 1)
                d[k.strip()] = v.strip()
    except Exception:
        pass
    return d


def write_kv(path, key, value, header="# Glyph settings\n"):
    d = read_kv(path)
    if value is None:
        d.pop(key, None)
    else:
        d[key] = str(value)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(header + "".join(f"{k}={v}\n" for k, v in d.items()))


def rc_set(tag, value, cats=("touchpad",)):
    """Set <tag>value</tag> inside the <device> blocks of rc.xml (touchpad, or default = mouse)."""
    try:
        s = RCXML.read_text()
    except Exception:
        return False
    for cat in cats:
        start = f'<device category="{cat}">'
        if start not in s:
            s = s.replace("<libinput>", f"<libinput>\n    {start}\n    </device>", 1)
        a = s.index(start)
        b = s.index("</device>", a)
        block = s[a:b]
        if re.search(rf"<{tag}>.*?</{tag}>", block):
            block = re.sub(rf"<{tag}>.*?</{tag}>", f"<{tag}>{value}</{tag}>", block, count=1)
        else:
            block = block.replace(start, f"{start}\n      <{tag}>{value}</{tag}>", 1)
        s = s[:a] + block + s[b:]
    RCXML.write_text(s)
    bg(["labwc", "--reconfigure"])
    return True


CURSOR_COLOURS = [("#e6dac4", "Cream"), ("#a8957c", "Tan"), ("#ffb340", "Amber"), ("#b5b03c", "Olive"),
                  ("#8c9e3a", "Green"), ("#b8405c", "Rose"), ("#8fb0c8", "Blue"), ("#ffffff", "White")]


def apply_cursor(colour, size):
    """Make the Glyph pointer and tell labwc and the apps to use it."""
    write_kv(GCONF, "cursor_colour", colour)
    write_kv(GCONF, "cursor_size", str(size))
    env = CONF / "labwc" / "environment"
    try:
        lines = [l for l in env.read_text().splitlines() if not l.startswith(("XCURSOR_THEME=", "XCURSOR_SIZE="))]
        lines += ["XCURSOR_THEME=Glyph", f"XCURSOR_SIZE={size}"]
        env.write_text("\n".join(lines) + "\n")
    except Exception:
        pass
    script = ('glyph-cursors "$1" "$2" >/dev/null 2>&1; '
              'gsettings set org.gnome.desktop.interface cursor-theme Glyph 2>/dev/null; '
              'gsettings set org.gnome.desktop.interface cursor-size "$2" 2>/dev/null; '
              'labwc --reconfigure 2>/dev/null')
    bg(["sh", "-c", script, "cursor", colour, str(size)])


def rc_get(tag, default=""):
    try:
        m = re.search(rf"<{tag}>(.*?)</{tag}>", RCXML.read_text())
        return m.group(1) if m else default
    except Exception:
        return default



def follow_css(css):
    """Reload the Glyph style when it changes (a new colour, or another workspace colour)."""
    from gi.repository import Gio
    path = CONF / "panel" / "panel.css"
    mon = Gio.File.new_for_path(str(path)).monitor_file(Gio.FileMonitorFlags.NONE, None)

    def changed(*_):
        try:
            css.load_from_path(str(path))
        except Exception:
            pass
    mon.connect("changed", lambda m, f, o, ev: GLib.timeout_add(150, lambda: (changed(), False)[1])
                if ev in (Gio.FileMonitorEvent.CHANGES_DONE_HINT, Gio.FileMonitorEvent.CREATED) else None)
    css._glyph_monitor = mon      # keep it alive

class Settings(Gtk.Window):
    def __init__(self, start):
        super().__init__(title="Settings")
        self.set_default_size(820, 600)
        css = Gtk.CssProvider()
        try:
            css.load_from_path(str(CONF / "panel" / "panel.css"))
        except Exception:
            pass
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_USER)
        follow_css(css)
        root = Gtk.Box()
        root.get_style_context().add_class("panel")
        root.get_style_context().add_class("settings")
        self.add(root)
        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        side.get_style_context().add_class("side")
        side.set_size_request(210, -1)
        sscroll = Gtk.ScrolledWindow()
        sscroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        sscroll.add(side)
        root.pack_start(sscroll, False, False, 0)
        self.page_scroll = Gtk.ScrolledWindow()
        self.page_scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        root.pack_start(self.page_scroll, True, True, 0)
        self.navbtn = {}
        for group, items in SECTIONS:
            side.pack_start(self.lab(group, "lab sidehead"), False, False, 0)
            for name in items:
                b = Gtk.Button(label=name)
                b.get_style_context().add_class("nav")
                b.get_child().set_xalign(0)
                b.connect("clicked", lambda _b, n=name: self.show_page(n))
                side.pack_start(b, False, False, 0)
                self.navbtn[name] = b
        self.connect("key-press-event", lambda w, e: self.close() if e.keyval == Gdk.KEY_Escape else False)
        self.show_page(start if start in self.navbtn else "Appearance")

    # ---------- small builders
    def lab(self, text, cls=None, wrap=False):
        l = Gtk.Label(label=text, xalign=0)
        if wrap:
            l.set_line_wrap(True)
            l.set_max_width_chars(60)
        for c in (cls or "").split():
            l.get_style_context().add_class(c)
        return l

    def btn(self, text, cb, cls=None):
        b = Gtk.Button(label=text)
        for c in (cls or "").split():
            b.get_style_context().add_class(c)
        b.connect("clicked", lambda *_: cb())
        return b

    def opts(self, items, current, cb):
        """A row of option buttons; items = [(value, label)]."""
        box = Gtk.FlowBox()
        box.set_selection_mode(Gtk.SelectionMode.NONE)
        box.set_max_children_per_line(6)
        box.set_column_spacing(6)
        box.set_row_spacing(6)
        def pick(v, b):
            # light the chosen button at once; the change itself may take a moment
            for child in box.get_children():
                child.get_child().get_style_context().remove_class("on")
            b.get_style_context().add_class("on")
            cb(v)
        for v, t in items:
            b = self.btn(t, lambda: None, "seg on" if str(v) == str(current) else "seg")
            b.connect("clicked", lambda bb, v=v: pick(v, bb))
            if "<span" in t:
                b.get_child().set_use_markup(True)
            box.add(b)
        return box

    def toggle(self, title, desc, on, cb):
        b = Gtk.Button()
        b.get_style_context().add_class("togrow")
        h = Gtk.Box(spacing=10)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        v.pack_start(self.lab(title, "tn"), False, False, 0)
        if desc:
            v.pack_start(self.lab(desc, "ts", wrap=True), False, False, 0)
        h.pack_start(v, True, True, 0)
        st = self.lab("ON" if on else "OFF", "state on" if on else "state")
        h.pack_end(st, False, False, 0)
        b.add(h)

        def flip(*_):
            # show the new state at once; the change itself may take a moment
            st.set_text("OFF" if on else "ON")
            (st.get_style_context().remove_class if on else st.get_style_context().add_class)("on")
            cb(not on)
        b.connect("clicked", flip)
        return b

    def info(self, rows):
        g = Gtk.Grid(column_spacing=16, row_spacing=4)
        g.get_style_context().add_class("kv")
        for i, (k, v) in enumerate(rows):
            g.attach(self.lab(k, "dim"), 0, i, 1, 1)
            vl = self.lab(v)
            vl.set_selectable(True)
            vl.set_line_wrap(True)
            g.attach(vl, 1, i, 1, 1)
        return g

    def note(self, text):
        return self.lab(text, "ts", wrap=True)

    # ---------- pages
    def show_page(self, name):
        self.current = name
        for n, b in self.navbtn.items():
            ctx = b.get_style_context()
            (ctx.add_class if n == name else ctx.remove_class)("cur")
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        page.get_style_context().add_class("page")
        page.pack_start(self.lab(name, "h3"), False, False, 0)
        getattr(self, "page_" + re.sub(r"\W+", "_", name.lower()).strip("_"))(page)
        old = self.page_scroll.get_child()
        if old:
            self.page_scroll.remove(old)
            old.destroy()
        self.page_scroll.add(page)
        self.page_scroll.show_all()

    def refresh(self):
        GLib.timeout_add(250, lambda: (self.show_page(self.current), False)[1])

    def theme(self, *args):
        """Run glyph-theme in the background, so this window stays responsive."""
        try:
            # Runs apart from this window. If the window still closes during the change,
            # the helper opens Settings again on the same page.
            log = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "glyph-settings.log"
            script = ('glyph-theme "$@" >>"$LOG" 2>&1; sleep 1; '
                      'pgrep -f "bin/glyph-settings" >/dev/null || exec glyph-settings "$PAGE"')
            proc = subprocess.Popen(["sh", "-c", script, "glyph-theme", *args], stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL, start_new_session=True,
                                    env=dict(os.environ, LOG=str(log), PAGE=self.current))
        except Exception:
            return

        def done():
            if proc.poll() is None:
                return True
            try:
                if getattr(self, "css2", None):
                    Gtk.StyleContext.remove_provider_for_screen(Gdk.Screen.get_default(), self.css2)
                self.css2 = Gtk.CssProvider()
                self.css2.load_from_path(str(CONF / "panel" / "panel.css"))
                Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), self.css2, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)
            except Exception:
                pass
            self.refresh()
            return False
        GLib.timeout_add(200, done)

    def page_appearance(self, p):
        t = read_kv(THEME)
        p.pack_start(self.lab("MODE", "lab"), False, False, 0)
        p.pack_start(self.opts([("dark", "Dark"), ("oled", "OLED black"), ("light", "Light")], t.get("mode", "dark"),
                               lambda v: self.theme("--mode", v)), False, False, 0)
        p.pack_start(self.lab("SYSTEM COLOUR · colours the whole desktop", "lab"), False, False, 0)
        cur = t.get("colour", "#a8957c").lower()
        p.pack_start(self.opts([(c[1], f'<span foreground="{c[2]}">■</span> {c[0]}') for c in COLOURS], next((c[1] for c in COLOURS if c[2] == cur), ""),
                               lambda v: self.theme("--colour", v)), False, False, 0)
        p.pack_start(self.lab("SECOND COLOUR · focus, START, power, warnings", "lab"), False, False, 0)
        accents = [("amber", "#ffb340", "Amber"), ("orange", "#ff8a3d", "Orange"), ("rose", "#e8708c", "Rose"),
                   ("green", "#a8c060", "Green"), ("blue", "#7fb0e0", "Blue"), ("violet", "#b590d8", "Violet"),
                   ("cream", "#e6dac4", "Cream")]
        cur2 = t.get("accent", "#ffb340").lower()
        p.pack_start(self.opts([(k, f'<span foreground="{h}">■</span> {n}') for k, h, n in accents],
                               next((k for k, h, n in accents if h == cur2), ""),
                               lambda v: self.theme("--accent", v)), False, False, 0)
        p.pack_start(self.lab("WINDOW CORNERS", "lab"), False, False, 0)
        try:
            rad = int(t.get("radius", ""))
        except ValueError:
            rad = {"round": 8, "bol": 16}.get(t.get("corners", "square"), 0)
        shape = t.get("corners", "square") if rad else "square"
        p.pack_start(self.opts([("square", "Square"), ("round", "Rounded"), ("bol", "Round ends")], shape,
                               lambda v: self.theme("--set", "corners=" + v, "--set",
                                                    "radius=" + {"square": "0", "round": "8", "bol": "16"}[v])), False, False, 0)
        rrow = Gtk.Box(spacing=12)
        rsc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 16, 1)
        rsc.set_value(rad)
        rsc.set_draw_value(False)
        rsc.set_size_request(300, -1)
        rval = Gtk.Label(label="Square" if not rad else f"{rad} px")
        rval.set_width_chars(8)
        rsc.connect("value-changed", lambda w: rval.set_text("Square" if not int(w.get_value()) else f"{int(w.get_value())} px"))
        rsc.connect("button-release-event", lambda w, e: (self.theme("--set", f"radius={int(w.get_value())}",
                                                                     "--set", "corners=" + (("bol" if shape == "bol" else "round") if int(w.get_value()) else "square")), False)[1])
        rrow.pack_start(rsc, False, False, 0)
        rrow.pack_start(rval, False, False, 0)
        p.pack_start(rrow, False, False, 0)
        p.pack_start(self.note("How round windows, panels, buttons and cards are. Round ends gives buttons and fields round ends. Windows round only at the top: labwc cannot round the bottom of a window."), False, False, 0)
        p.pack_start(self.lab("TEXT SIZE", "lab"), False, False, 0)
        p.pack_start(self.opts([("12", "Small"), ("13", "Normal"), ("15", "Large")], t.get("textsize", "13"),
                               lambda v: self.theme("--set", "textsize=" + v)), False, False, 0)
        p.pack_start(self.lab("START MENU SIZE", "lab"), False, False, 0)
        p.pack_start(self.opts([("compact", "Compact · 560×500"), ("normal", "Normal · 680×600"), ("large", "Large · 780×720")],
                               t.get("startsize", "normal"), lambda v: self.theme("--set", "startsize=" + v)), False, False, 0)
        p.pack_start(self.lab("SCANLINES", "lab"), False, False, 0)
        p.pack_start(self.opts([("on", "On"), ("off", "Off")], t.get("scanlines", "on"),
                               lambda v: (self.theme("--set", "scanlines=" + v), bg(["pkill", "-HUP", "-f", "bin/glyph-desk"]))),
                     False, False, 0)
        if t.get("scanlines", "on") != "off":
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 4, 30, 1)
            sc.set_value(int(t.get("scanstrength", "12")))
            sc.set_tooltip_text("Strength")
            sc.connect("button-release-event", lambda w, e: (self.theme("--set", f"scanstrength={int(w.get_value())}"),
                                                              GLib.timeout_add(800, lambda: (bg(["pkill", "-HUP", "-f", "bin/glyph-desk"]), False)[1]), False)[2])
            p.pack_start(sc, False, False, 0)
        p.pack_start(self.toggle("Shadows", "A shadow under windows, the start menu and the panels, like the prototype.",
                                 t.get("shadows", "yes") != "no",
                                 lambda on: self.theme("--shadows", "yes" if on else "no")), False, False, 0)
        p.pack_start(self.toggle("Colour Firefox and Vivaldi too", "They follow your mode and colour after a restart of the browser.",
                                 t.get("browsers", "yes") == "yes",
                                 lambda on: (write_kv(THEME, "browsers", "yes" if on else "no", "# Glyph look\n"), self.theme())), False, False, 0)
        p.pack_start(self.note("Choosing a mode or system colour also gives the background the Glyph colour again. "
                               "Windows, the taskbar, menus and panels change at once. Apps such as Files and the text editor "
                               "change when you open them again."), False, False, 0)

    def page_background(self, p):
        t = read_kv(THEME)
        pic = t.get("background", "")
        p.pack_start(self.lab("TYPE", "lab"), False, False, 0)
        p.pack_start(self.opts([("plain", "Plain colour"), ("picture", "Your picture")], "picture" if pic else "plain",
                               lambda v: (write_kv(THEME, "background", None if v == "plain" else (pic or None)), bg(["glyph-bg"]), self.refresh())), False, False, 0)
        p.pack_start(self.toggle("Clock and info on the desktop", "Big clock, date, uptime, battery, power and network at the bottom right, and corner marks.",
                                 t.get("desk", "info") != "clean",
                                 lambda on: (write_kv(THEME, "desk", "info" if on else "clean"), bg(["glyph-bg"]), self.refresh())), False, False, 0)
        p.pack_start(self.lab("YOUR PICTURE", "lab"), False, False, 0)
        fc = Gtk.FileChooserButton(title="Choose a picture")
        flt = Gtk.FileFilter()
        flt.add_mime_type("image/*")
        fc.add_filter(flt)
        if pic:
            fc.set_filename(pic)
        fc.connect("file-set", lambda f: (write_kv(THEME, "background", f.get_filename()), bg(["glyph-bg"]), self.refresh()))
        p.pack_start(fc, False, False, 0)
        p.pack_start(self.lab("FIT", "lab"), False, False, 0)
        p.pack_start(self.opts([("fill", "Fill"), ("fit", "Fit"), ("center", "Centre"), ("tile", "Tile")], t.get("bgmode", "fill"),
                               lambda v: (write_kv(THEME, "bgmode", v), bg(["glyph-bg"]), self.refresh())), False, False, 0)
        p.pack_start(self.lab("COLOUR", "lab"), False, False, 0)
        cb = Gtk.ColorButton()
        rgba = Gdk.RGBA()
        rgba.parse(t.get("bgcolour") or "#221f1b")
        cb.set_rgba(rgba)

        def set_col(b):
            c = b.get_rgba()
            write_kv(THEME, "bgcolour", "#%02x%02x%02x" % (int(c.red * 255), int(c.green * 255), int(c.blue * 255)))
            bg(["glyph-bg"])
        cb.connect("color-set", set_col)
        row = Gtk.Box(spacing=8)
        row.pack_start(cb, False, False, 0)
        row.pack_start(self.btn("Use the Glyph colour", lambda: (write_kv(THEME, "bgcolour", None), bg(["glyph-bg"]), self.refresh()), "small"), False, False, 0)
        p.pack_start(row, False, False, 0)

    def page_taskbar(self, p):
        d = read_kv(GCONF)
        on = lambda k: d.get("bar_" + k, "on") != "off"

        def setb(k, v):
            sh(["glyph-bar", "set", k, "on" if v else "off"])
            self.refresh()
        p.pack_start(self.note("Choose what the taskbar shows. START, SETTINGS, the clock and the power button always stay."), False, False, 0)
        for k, t, desc in (("workspaces", "Workspaces", "The buttons 1 2 3 4. Ctrl+Alt+1-4 still works when they are hidden."),
                           ("apps", "App buttons", "A button for each open window, with its letter and name."),
                           ("windows", "Open windows ▦", "The window count; click it for the list of open windows."),
                           ("tray", "Tray icons", "Small icons of apps that run in the background."),
                           ("media", "Music button", "Shows what plays (any app) with previous, pause and next.")):
            p.pack_start(self.toggle(t, desc, on(k), lambda v, k=k: setb(k, v)), False, False, 0)
        # workspace colours
        t = read_kv(THEME)
        own = t.get("ws_colours", "same") == "own"

        def ws_apply():
            self.theme()
            bg(["pkill", "-HUP", "-f", "bin/glyph-desk"])
        p.pack_start(self.toggle("Workspace colours", "Give every workspace its own colour: its button on the taskbar, "
                                 "and the clock and corner marks on the desktop, so you see where you are.", own,
                                 lambda v: (write_kv(THEME, "ws_colours", "own" if v else "same"), ws_apply())), False, False, 0)
        if own:
            defaults = {"1": "system", "2": "green", "3": "blue", "4": "rose"}
            items = [("system", "System colour")] + [(c[1], f'<span foreground="{c[2]}">■</span> {c[0]}') for c in COLOURS]
            for n in "1234":
                p.pack_start(self.lab(f"WORKSPACE {n}", "lab"), False, False, 0)
                p.pack_start(self.opts(items, t.get("ws" + n, defaults[n]),
                                       lambda v, n=n: (write_kv(THEME, "ws" + n, v), ws_apply())), False, False, 0)

    def page_notifications(self, p):
        t = read_kv(THEME)
        dnd = "do-not-disturb" in sh(["makoctl", "mode"])
        running = bool(sh(["pgrep", "-x", "mako"]).strip())
        if not running:
            p.pack_start(self.note("The notification program (mako) is not running, so no pop-ups appear. "
                                   "Press the button to start it."), False, False, 0)
            p.pack_start(self.btn("Start notifications", lambda: (bg(["glyph-notifyd"]), self.refresh()), "amber"), False, False, 0)
        p.pack_start(self.toggle("Do not disturb", "Hide pop-ups. They still go to the list under the clock.", dnd,
                                 lambda on: (sh(["makoctl", "mode", "-a" if on else "-r", "do-not-disturb"]), self.refresh())), False, False, 0)
        p.pack_start(self.toggle("Play a sound", "A short beep when a message arrives.", t.get("notif_sound", "yes") == "yes",
                                 lambda on: (write_kv(THEME, "notif_sound", "yes" if on else "no"), self.theme())), False, False, 0)
        pos = t.get("notif_pos", "tr")
        p.pack_start(self.lab("WHERE POP-UPS APPEAR", "lab"), False, False, 0)
        p.pack_start(self.opts([("tr", "Top right"), ("tc", "Top middle"), ("tl", "Top left"),
                                ("br", "Bottom right"), ("bc", "Bottom middle"), ("bl", "Bottom left")], pos,
                               lambda v: (write_kv(THEME, "notif_pos", v), self.theme())), False, False, 0)
        pv = Gtk.DrawingArea()
        pv.set_size_request(200, 120)
        pv.set_halign(Gtk.Align.START)

        def hexrgb(h):
            h = h.lstrip("#")
            return [int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)]

        pal = dict(l.split()[:2] for l in sh(["glyph-theme", "--print"]).splitlines() if len(l.split()) >= 2)

        def draw_pv(w, cr):
            W, H = 200, 120
            col = lambda k, d: hexrgb(pal.get(k, d))
            hi, view, panel, title = col("hi", "#5c544a"), col("view", "#1a1714"), col("panel", "#29251f"), col("title", "#a8957c")
            cr.set_source_rgb(*view); cr.rectangle(0, 0, W, H); cr.fill()
            cr.set_source_rgb(*panel); cr.rectangle(0, H - 12, W, 12); cr.fill()
            cr.set_source_rgb(*hi); cr.set_line_width(1)
            cr.rectangle(0.5, 0.5, W - 1, H - 1); cr.stroke()
            cr.move_to(0, H - 12.5); cr.line_to(W, H - 12.5); cr.stroke()
            x = {"r": W - 62, "l": 6, "c": 72}[pos[1]]
            y = 6 if pos[0] == "t" else H - 34
            cr.set_source_rgb(*title); cr.rectangle(x, y, 56, 16); cr.fill()
            return False
        pv.connect("draw", draw_pv)
        p.pack_start(pv, False, False, 0)
        p.pack_start(self.lab("KEEP POP-UPS ON SCREEN FOR", "lab"), False, False, 0)
        p.pack_start(self.opts([("3", "3 s"), ("5", "5 s"), ("10", "10 s")], t.get("notif_time", "5"),
                               lambda v: (write_kv(THEME, "notif_time", v), self.theme())), False, False, 0)
        row = Gtk.Box(spacing=8)
        row.pack_start(self.btn("Show a test notification",
                                lambda: bg(["notify-send", "-a", "Glyph", "Test", "This is where your notifications appear."])), False, False, 0)
        row.pack_start(self.btn("Clear notification history", self.clear_notifs), False, False, 0)
        p.pack_start(row, False, False, 0)
        p.pack_start(self.note("Urgent messages stay until you click them. Earlier messages are in the list under the clock."), False, False, 0)

    def clear_notifs(self):
        sh(["makoctl", "dismiss", "--all"])
        try:
            out = sh(["makoctl", "history"])
            ids = set(re.findall(r'"id":\s*\{[^}]*"data":\s*(\d+)', out)) | set(re.findall(r"^Notification (\d+):", out, re.M))
            f = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "glyph-notif-cleared"
            old = set(f.read_text().split()) if f.exists() else set()
            f.write_text(" ".join(sorted(old | ids)[-500:]))
        except Exception:
            pass

    def page_display(self, p):
        out = sh(["wlr-randr"]) if has("wlr-randr") else ""
        outputs = re.findall(r"^(\S+) \"(.*?)\"", out, re.M)
        if not outputs:
            p.pack_start(self.note("Install wlr-randr to see your screens here: sudo apt install wlr-randr"), False, False, 0)
        gconf = read_kv(GCONF)
        for name, desc in outputs:
            block = out.split(name + " ", 1)[1].split("\n\n")[0] if name in out else ""
            cur = re.search(r"(\d+x\d+) px, ([\d.]+) Hz \(.*current", block)
            scale = re.search(r"Scale: ([\d.]+)", block)
            p.pack_start(self.lab(f"{name} · {desc}", "tn"), False, False, 0)
            p.pack_start(self.info([("Resolution", f"{cur.group(1)} at {round(float(cur.group(2)))} Hz" if cur else "not reported"),
                                    ("Scale", f"{round(float(scale.group(1)) * 100)}%" if scale else "100%")]), False, False, 0)
            p.pack_start(self.lab("SCALE · smaller than 100% fits more on the screen, bigger is easier to read", "lab"), False, False, 0)
            p.pack_start(self.opts([("0.75", "75%"), ("0.8", "80%"), ("0.9", "90%"), ("1", "100%"), ("1.1", "110%"), ("1.25", "125%"),
                                    ("1.5", "150%"), ("1.75", "175%"), ("2", "200%")],
                                   gconf.get("scale_" + name, (scale.group(1).rstrip("0").rstrip(".") if scale else "1")),
                                   lambda v, n=name: (sh(["wlr-randr", "--output", n, "--scale", v]), write_kv(GCONF, "scale_" + n, v), bg(["glyph-bar"]), self.refresh())), False, False, 0)
        if has("wdisplays"):
            p.pack_start(self.btn("Arrange screens and resolution…", lambda: bg(["wdisplays"])), False, False, 0)
        else:
            p.pack_start(self.note("For more screens and resolutions: sudo apt install wdisplays"), False, False, 0)
        p.pack_start(self.note("Glyph puts your scale back every time you sign in."), False, False, 0)
        # night light
        g = read_kv(GCONF)
        if has("wlsunset"):
            p.pack_start(self.toggle("Night light", "A warmer screen in the evening, easier on your eyes.", g.get("night") == "on",
                                     lambda on: (sh(["glyph-night", "on" if on else "off"]), self.refresh())), False, False, 0)
            if g.get("night") == "on":
                def night(k, v):
                    write_kv(GCONF, k, v)
                    sh(["glyph-night", "on"])
                p.pack_start(self.lab("WARMTH", "lab"), False, False, 0)
                p.pack_start(self.opts([("4000", "Warm"), ("3400", "Warmer"), ("2800", "Warmest")], g.get("night_temp", "3400"),
                                       lambda v: night("night_temp", v)), False, False, 0)
                p.pack_start(self.lab("WHEN", "lab"), False, False, 0)
                p.pack_start(self.opts([("evening", "Evening · 19:30 – 07:00"), ("always", "All day")], g.get("night_when", "evening"),
                                       lambda v: night("night_when", v)), False, False, 0)
        else:
            p.pack_start(self.note("Night light: sudo apt install wlsunset"), False, False, 0)

    def page_sound(self, p):
        st = sh(["wpctl", "status"])
        sinks = []
        if "Sinks:" in st:
            part = st.split("Sinks:", 1)[1].split("Sources:", 1)[0].split("Filters:", 1)[0]
            for l in part.splitlines():
                m = re.search(r"(\*?)\s*(\d+)\.\s+(.+?)(?:\s+\[vol:.*)?$", l)
                if m:
                    sinks.append((m.group(2), m.group(3).strip(), bool(m.group(1))))
        p.pack_start(self.lab("OUTPUT", "lab"), False, False, 0)
        if sinks:
            p.pack_start(self.opts([(i, n) for i, n, _ in sinks], next((i for i, n, d in sinks if d), ""),
                                   lambda v: (sh(["wpctl", "set-default", v]), self.refresh())), False, False, 0)
        else:
            p.pack_start(self.note("No sound devices found (is PipeWire running?)."), False, False, 0)
        vol = re.search(r"([\d.]+)", sh(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"]))
        if vol:
            p.pack_start(self.lab("VOLUME", "lab"), False, False, 0)
            sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
            sc.set_value(round(float(vol.group(1)) * 100))
            sc.connect("value-changed", lambda s: sh(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{int(s.get_value())}%"]))
            p.pack_start(sc, False, False, 0)
        if has("pavucontrol"):
            p.pack_start(self.btn("Volume per app and microphone…", lambda: bg(["pavucontrol"])), False, False, 0)
        else:
            p.pack_start(self.note("For volume per app and the microphone: sudo apt install pavucontrol"), False, False, 0)

