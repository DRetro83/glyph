    def embed(self, p, script, cls):
        """Show the Wi-Fi or Bluetooth window right inside this page."""
        path = shutil.which(script)
        if not path:
            p.pack_start(self.note(f"{script} is missing: run glyph-update."), False, False, 0)
            return None
        try:
            from importlib.machinery import SourceFileLoader
            mod = SourceFileLoader(script.replace("-", "_"), path).load_module()
            view = getattr(mod, cls)()
        except Exception as e:
            p.pack_start(self.note(f"Could not show this page: {e}"), False, False, 0)
            return None
        view.set_size_request(-1, 470)
        view.get_style_context().add_class("embedded")
        p.pack_start(view, True, True, 0)
        return view

    def page_disks(self, p):
        self.embed(p, "glyph-disks", "DisksView")

    def page_network(self, p):
        rows = []
        for l in sh(["nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "dev"]).splitlines():
            f = l.split(":")
            if len(f) >= 4 and f[1] in ("ethernet", "gsm"):
                rows.append((f"{f[0]} ({f[1]})", f[2] + (" · " + f[3] if f[3] else "")))
        if rows:
            p.pack_start(self.info(rows), False, False, 0)
        p.pack_start(self.lab("WI-FI", "lab"), False, False, 0)
        self.embed(p, "glyph-wifi", "WifiView")
        if has("nm-connection-editor"):
            p.pack_start(self.btn("Advanced: VPN, wired, fixed IP…", lambda: bg(["nm-connection-editor"])), False, False, 0)

