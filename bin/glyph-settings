        p.pack_start(row, False, False, 0)
        p.pack_start(self.note("Debian asks for your password to change the time zone."), False, False, 0)

    DEFAULTS = [("WEB BROWSER", ["x-scheme-handler/http", "x-scheme-handler/https", "text/html"]),
                ("FILES", ["inode/directory"]),
                ("MUSIC", ["audio/mpeg", "audio/flac", "audio/ogg", "audio/x-vorbis+ogg", "audio/opus", "audio/mp4",
                           "audio/x-m4a", "audio/aac", "audio/x-wav", "audio/wav"]),
                ("VIDEO", ["video/mp4", "video/x-matroska", "video/webm", "video/x-msvideo", "video/quicktime"]),
                ("PICTURES", ["image/png", "image/jpeg", "image/gif", "image/webp", "image/bmp", "image/svg+xml"]),
                ("PDF", ["application/pdf"]),
                ("TEXT FILES", ["text/plain"]),
                ("MAIL", ["x-scheme-handler/mailto"])]

    def page_default_apps(self, p):
        from gi.repository import Gio
        mime = CONF.parent / "glyph-mimeapps.list"
        cur = {}
        try:
            for line in mime.read_text().splitlines():
                if "=" in line and not line.startswith("["):
                    k, v = line.split("=", 1)
                    cur[k.strip()] = v.strip().split(";")[0]
        except Exception:
            pass

        def save(types, app_id):
            lines = []
            try:
                lines = [l for l in mime.read_text().splitlines() if l.split("=", 1)[0].strip() not in types]
            except Exception:
                pass
            if not lines or lines[0].strip() != "[Default Applications]":
                lines = ["[Default Applications]"] + [l for l in lines if l.strip() != "[Default Applications]"]
            lines += [f"{t}={app_id}" for t in types]
            mime.write_text("\n".join(lines) + "\n")

        p.pack_start(self.note("Which app opens a file or link in Glyph. KDE keeps its own choices."), False, False, 0)
        for title, types in self.DEFAULTS:
            apps, seen = [], set()
            for t in types[:2]:
                for a in Gio.AppInfo.get_all_for_type(t):
                    if a.get_id() not in seen and a.should_show():
                        seen.add(a.get_id())
                        apps.append(a)
            if not apps:
                continue
            now = cur.get(types[0])
            if not now:
                d = Gio.AppInfo.get_default_for_type(types[0], False)
                now = d.get_id() if d else ""
            p.pack_start(self.lab(title, "lab"), False, False, 0)
            p.pack_start(self.opts([(a.get_id(), a.get_display_name()) for a in apps[:8]], now,
                                   lambda v, types=types: save(types, v)), False, False, 0)
        terms = [(t, n) for t, n in (("xfce4-terminal", "Xfce Terminal"), ("foot", "foot"), ("kitty", "kitty"),
                                     ("alacritty", "Alacritty"), ("konsole", "Konsole")) if has(t)]
        if terms:
            p.pack_start(self.lab("TERMINAL", "lab"), False, False, 0)
            p.pack_start(self.opts(terms, read_kv(GCONF).get("terminal", terms[0][0]),
                                   lambda v: write_kv(GCONF, "terminal", v)), False, False, 0)

    def in_terminal(self, title, cmd):
        """Run a command that asks for your password in a small terminal window."""
        bg(["foot", "-T", title, "sh", "-c", cmd + "; echo; read -p 'Press Enter to close ' x"])

    def page_printers(self, p):
        if not has("lpstat"):
            p.pack_start(self.note("Printing is not installed. In a terminal: sudo apt install cups system-config-printer"), False, False, 0)
            p.pack_start(self.btn("Install printing…", lambda: self.in_terminal("Printing", "sudo apt install cups system-config-printer")), False, False, 0)
            return
        default = sh(["lpstat", "-d"]).split(":")[-1].strip()
        printers = [l.split()[1] for l in sh(["lpstat", "-p"]).splitlines() if l.startswith("printer ")]
        if printers:
            for pr in printers:
                state = next((l for l in sh(["lpstat", "-p", pr]).splitlines() if l.startswith("printer")), "")
                row = Gtk.Box(spacing=8)
                row.pack_start(self.lab(pr + ("  · default" if pr == default else ""), "pname" if pr == default else ""), False, False, 0)
                row.pack_start(self.lab("idle" if "idle" in state else "busy" if "printing" in state else "off" if "disabled" in state else "", "dim"), False, False, 0)
                if pr != default:
                    row.pack_end(self.btn("Make default", lambda pr=pr: (sh(["lpoptions", "-d", pr]), self.refresh())), False, False, 0)
                row.pack_end(self.btn("Test page", lambda pr=pr: bg(["lp", "-d", pr, "/usr/share/cups/data/testprint"])), False, False, 0)
                p.pack_start(row, False, False, 0)
        else:
            p.pack_start(self.note("No printers yet. Most network and USB printers are found by themselves; "
                                   "otherwise add one here."), False, False, 0)
        if has("system-config-printer"):
            p.pack_start(self.btn("Add or change printers…", lambda: bg(["system-config-printer"]), "amber"), False, False, 0)
        p.pack_start(self.btn("Printer page in the browser (CUPS)…", lambda: bg(["xdg-open", "http://localhost:631/printers/"])), False, False, 0)

    def page_mobile_network(self, p):
        if not has("mmcli"):
            p.pack_start(self.note("No mobile modem software. Only needed for a laptop with a SIM card: sudo apt install modemmanager"), False, False, 0)
            return
        modems = re.findall(r"/Modem/(\d+)", sh(["mmcli", "-L"]))
        if not modems:
            p.pack_start(self.note("No mobile modem found. A laptop with a SIM card shows it here."), False, False, 0)
            return
        info = sh(["mmcli", "-m", modems[0]])
        get = lambda k: (re.search(rf"{k}\s*:\s*(.+)", info).group(1).strip() if re.search(rf"{k}\s*:\s*(.+)", info) else "?")
        p.pack_start(self.info([("Modem", get("model")), ("Operator", get("operator name")), ("Signal", get("signal quality")),
                                ("State", get("  state"))]), False, False, 0)
        p.pack_start(self.toggle("Mobile data", "Use the SIM card for internet.", sh(["nmcli", "radio", "wwan"]).strip() == "enabled",
                                 lambda on: (sh(["nmcli", "radio", "wwan", "on" if on else "off"]), self.refresh())), False, False, 0)
        if has("nm-connection-editor"):
            p.pack_start(self.btn("APN and more…", lambda: bg(["nm-connection-editor"])), False, False, 0)

    def page_users(self, p):
        import pwd
        import grp
        me = pwd.getpwuid(os.getuid())
        groups = sorted(g.gr_name for g in grp.getgrall() if me.pw_name in g.gr_mem)
        p.pack_start(self.info([("You", me.pw_name), ("Full name", me.pw_gecos.split(",")[0] or "—"), ("Home folder", me.pw_dir),
                                ("Administrator", "yes" if "sudo" in groups else "no"), ("Groups", ", ".join(groups) or "—")]),
                     False, False, 0)
        p.pack_start(self.btn("Change your password…", lambda: self.in_terminal("Password", "passwd"), "amber"), False, False, 0)
        p.pack_start(self.btn("Change your full name…", lambda: self.in_terminal("Full name", "read -p 'Full name: ' n && chfn -f \"$n\"")), False, False, 0)
        others = [u for u in pwd.getpwall() if 1000 <= u.pw_uid < 60000 and u.pw_name != me.pw_name
                  and not u.pw_shell.endswith(("nologin", "false"))]
        admins = set(grp.getgrnam("sudo").gr_mem) if "sudo" in [g.gr_name for g in grp.getgrall()] else set()
        if others:
            p.pack_start(self.lab("OTHER PEOPLE", "lab"), False, False, 0)
            for u in others:
                row = Gtk.Box(spacing=8)
                adm = u.pw_name in admins
                row.pack_start(self.lab(u.pw_name, "pname"), False, False, 0)
                row.pack_start(self.lab((u.pw_gecos.split(",")[0] + " · " if u.pw_gecos.split(",")[0] else "")
                                        + ("administrator" if adm else "standard user"), "dim"), False, False, 0)
                row.pack_end(self.btn("Remove…", lambda n=u.pw_name: self.in_terminal(
                    "Remove a person", f"read -p 'Remove {n}? Their home folder stays. Type yes: ' a && [ \"$a\" = yes ] && sudo deluser {n}")),
                    False, False, 0)
                row.pack_end(self.btn("Make standard user" if adm else "Make administrator", lambda n=u.pw_name, adm=adm: self.in_terminal(
                    "Administrator", f"sudo deluser {n} sudo" if adm else f"sudo adduser {n} sudo")), False, False, 0)
                p.pack_start(row, False, False, 0)
        p.pack_start(self.lab("ADD A PERSON", "lab"), False, False, 0)
        p.pack_start(self.note("A standard user can use the computer but cannot install apps or change the system "
                               "(no sudo). An administrator can. Adding someone needs your password once."), False, False, 0)
        add = ("read -p 'Login name (small letters, no spaces): ' n && read -p 'Full name: ' f && "
               "sudo adduser --comment \"$f\" \"$n\"")
        row = Gtk.Box(spacing=8)
        row.pack_start(self.btn("Add a standard user…", lambda: self.in_terminal("Add a person", add), "amber"), False, False, 0)
        row.pack_start(self.btn("Add an administrator…", lambda: self.in_terminal("Add an administrator", add + " && sudo adduser \"$n\" sudo")),
                       False, False, 0)
        p.pack_start(row, False, False, 0)

    def page_language_region(self, p):
        st = sh(["localectl", "status"])
        loc = re.search(r"LANG=(\S+)", st)
        kb = re.search(r"X11 Layout:\s*(\S+)", st)
        p.pack_start(self.info([("Language", loc.group(1) if loc else os.environ.get("LANG", "?")),
                                ("Keyboard", kb.group(1) if kb else "?"),
                                ("Time zone", sh(["timedatectl", "show", "-p", "Timezone", "--value"]).strip() or "?")]), False, False, 0)
        p.pack_start(self.lab("GLYPH LANGUAGE", "lab"), False, False, 0)
        try:
            langs = glyph_lang.languages()
            cur = glyph_lang.current()
        except Exception:
            langs, cur = [("en", "English")], "en"
        p.pack_start(self.opts(langs, cur, self.set_language), False, False, 0)
        p.pack_start(self.note("Glyph is English by default. Every language is a text file: copy "
                               "/usr/local/share/glyph/lang/nl.txt to ~/.config/glyph/lang/, rename it (de.txt, fr.txt…) "
                               "and translate the right-hand side. Anything missing stays English."), False, False, 0)
        p.pack_start(self.btn("Open the language folder", self.open_lang_dir), False, False, 0)
        p.pack_start(self.lab("LANGUAGE OF YOUR APPS", "lab"), False, False, 0)
        p.pack_start(self.note("The language and formats here are used by your apps, "
                               "for example dates and numbers in LibreOffice."), False, False, 0)
        p.pack_start(self.btn("Change language and formats…", lambda: self.in_terminal("Language", "sudo dpkg-reconfigure locales")), False, False, 0)
        p.pack_start(self.btn("Change the keyboard layout…", lambda: self.in_terminal("Keyboard", "sudo dpkg-reconfigure keyboard-configuration && echo 'Run glyph-update, then sign in again.'")), False, False, 0)

    def set_language(self, code):
        write_kv(GCONF, "lang", code)
        bg(["pkill", "-RTMIN+10", "waybar"])
        bg(["pkill", "-HUP", "-f", "glyph-desk"])
        # reopen Settings in the new language, on the same page
        GLib.timeout_add(150, lambda: os.execv(sys.executable, [sys.executable, os.path.realpath(__file__), "Language & region"]))

    def open_lang_dir(self):
        d = Path.home() / ".config/glyph/lang"
        d.mkdir(parents=True, exist_ok=True)
        for src in (Path("/usr/local/share/glyph/lang"), Path(os.path.realpath(__file__)).parent.parent / "share/lang"):
            for f in src.glob("*.txt") if src.is_dir() else []:
                if not (d / f.name).exists():
                    (d / f.name).write_text("# name: " + f.read_text().splitlines()[0].split(":", 1)[-1].strip()
                                            + "\n# Your own lines. They go before the ones that come with Glyph.\n")
        bg(["glyph-files", str(d)])

    def page_privacy(self, p):
        recent = Path.home() / ".local/share/recently-used.xbel"
        n = len(re.findall("<bookmark ", recent.read_text(errors="ignore"))) if recent.exists() else 0
        p.pack_start(self.lab("RECENT FILES", "lab"), False, False, 0)
        p.pack_start(self.note(f"Apps remember {n} recently opened files."), False, False, 0)
        p.pack_start(self.btn("Forget recent files", lambda: (recent.write_text('<?xml version="1.0" encoding="UTF-8"?>\n<xbel version="1.0"></xbel>\n'), self.refresh())),
                     False, False, 0)
        p.pack_start(self.lab("NOTIFICATIONS", "lab"), False, False, 0)
        p.pack_start(self.btn("Clear notification history", self.clear_notifs), False, False, 0)
        p.pack_start(self.lab("TRASH", "lab"), False, False, 0)
        p.pack_start(self.btn("Empty the trash", lambda: (sh(["gio", "trash", "--empty"]), self.refresh())), False, False, 0)
        p.pack_start(self.lab("SCREEN LOCK", "lab"), False, False, 0)
        p.pack_start(self.note("The screen locks by itself after a while and always before sleep: Power & lock."), False, False, 0)
        p.pack_start(self.btn("Power & lock…", lambda: self.show_page("Power & lock")), False, False, 0)
        users = [l for l in sh(["fuser", "-v", "/dev/video0"]).splitlines()] if Path("/dev/video0").exists() else []
        p.pack_start(self.lab("CAMERA", "lab"), False, False, 0)
        p.pack_start(self.note("Camera in use right now." if users else "The camera is not in use." if Path("/dev/video0").exists()
                               else "No camera found."), False, False, 0)

    def page_accessibility(self, p):
        t = read_kv(THEME)
        p.pack_start(self.lab("BIGGER TEXT", "lab"), False, False, 0)
        p.pack_start(self.opts([("13", "Normal"), ("15", "Large")], t.get("textsize", "13"),
                               lambda v: self.theme("--set", "textsize=" + v)), False, False, 0)
        p.pack_start(self.lab("MORE CONTRAST", "lab"), False, False, 0)
        p.pack_start(self.opts([("dark", "Dark"), ("oled", "Black (most contrast)"), ("light", "Light")], t.get("mode", "dark"),
                               lambda v: self.theme("--mode", v)), False, False, 0)
        p.pack_start(self.lab("BIGGER POINTER", "lab"), False, False, 0)
        p.pack_start(self.opts([("24", "Small"), ("32", "Normal"), ("48", "Large")], read_kv(GCONF).get("cursor_size", "24"),
                               lambda v: apply_cursor(read_kv(GCONF).get("cursor_colour", "#e6dac4"), v)), False, False, 0)
        p.pack_start(self.lab("SCANLINES", "lab"), False, False, 0)
        p.pack_start(self.opts([("on", "On"), ("off", "Off (calmer)")], t.get("scanlines", "on"),
                               lambda v: self.theme("--set", "scanlines=" + v)), False, False, 0)
        p.pack_start(self.lab("EVERYTHING BIGGER", "lab"), False, False, 0)
        p.pack_start(self.btn("Display scale…", lambda: self.show_page("Display")), False, False, 0)
        p.pack_start(self.note("Keyboard: Ctrl+plus makes text bigger in most apps and the terminal."), False, False, 0)

    def page_updates(self, p):
        p.pack_start(self.note("Debian and your apps: this opens a terminal that asks for your password, "
                               "shows what will change and asks before it installs."), False, False, 0)
        p.pack_start(self.btn("Open Software → Updates", lambda: bg(["glyph-software", "updates"]), "amber"), False, False, 0)
        p.pack_start(self.btn("Check and install updates in a terminal…", lambda: bg(["foot", "-T", "Updates", "sh", "-c",
                     "sudo apt update && sudo apt upgrade; command -v flatpak >/dev/null && flatpak update; echo; read -p 'Press Enter to close ' x"])), False, False, 0)
        p.pack_start(self.lab("GLYPH", "lab"), False, False, 0)
        p.pack_start(self.btn("Update Glyph from GitHub…", lambda: bg(["foot", "-T", "Glyph update", "sh", "-c", "glyph-update; echo; read -p 'Press Enter to close ' x"])), False, False, 0)

    def page_about(self, p):
        osr = read_kv(Path("/etc/os-release"))
        mem = re.search(r"MemTotal:\s+(\d+)", Path("/proc/meminfo").read_text()) if Path("/proc/meminfo").exists() else None
        cpu = re.search(r"model name\s*:\s*(.+)", Path("/proc/cpuinfo").read_text()) if Path("/proc/cpuinfo").exists() else None
        gpu = re.search(r"(?:VGA|3D|Display)[^:]*: (.+)", sh(["lspci"]))
        src = (CONF / "source").read_text().strip() if (CONF / "source").exists() else ""
        ver = (Path(src) / "VERSION").read_text().strip() if src and (Path(src) / "VERSION").exists() else ""
        commit = sh(["git", "-C", src, "rev-parse", "--short", "HEAD"]).strip() if src else ""
        ver = (ver + (f" ({commit})" if commit else "")).strip()
        df = shutil.disk_usage("/")
        p.pack_start(self.lab("GLYPH", "h1"), False, False, 0)
        p.pack_start(self.lab("a light, text-first desktop", "dim"), False, False, 0)
        p.pack_start(self.info([("System", osr.get("PRETTY_NAME", "Debian").strip('"')), ("Kernel", sh(["uname", "-r"]).strip()),
                                ("Desktop", "Glyph " + (ver or "") + " · labwc"), ("Processor", cpu.group(1) if cpu else "?"),
                                ("Memory", f"{int(mem.group(1)) // 1024 // 1024 + 1} GB" if mem else "?"),
                                ("Graphics", gpu.group(1) if gpu else "?"),
                                ("Disk", f"{df.used // 10**9} GB of {df.total // 10**9} GB used")]), False, False, 0)


if __name__ == "__main__":
    # Leave the taskbar's process group: when the taskbar reloads (after a colour
    # change) it ends its whole group, which closed this window and every app
    # started from here.
    try:
        os.setsid()
    except Exception:
        pass
    import faulthandler
    try:   # if Settings ever closes by itself, the reason is in this file
        _log = open(Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "glyph-settings.log", "a")
        os.dup2(_log.fileno(), 2)          # GTK and Wayland messages too
        faulthandler.enable(_log)
        sys.stderr = _log
        print(time.strftime("--- %Y-%m-%d %H:%M:%S Settings started"), file=_log, flush=True)
    except Exception:
        pass
    GLib.set_prgname("glyph-settings")
    win = Settings(sys.argv[1] if len(sys.argv) > 1 else "Appearance")
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()
