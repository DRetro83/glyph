#!/usr/bin/env python3
"""glyph-sound - short Glyph beeps, like the prototype.

  glyph-sound notify | error | plug | unplug | shot | login | logout  [--style glyph|soft|chime]
Plays with pw-play (PipeWire) or paplay. Pick the style, or your own message
sound, in Settings -> Sound; turn the message sound off in Settings -> Notifications."""
import math
import os
import shutil
import struct
import subprocess
import sys
import wave
from pathlib import Path

SNDS = {"notify": [(880, .06), (1320, .09)], "login": [(440, .09), (660, .09), (880, .09), (1320, .18)],
        "logout": [(1320, .09), (880, .09), (660, .09), (440, .18)], "error": [(220, .12), (165, .2)],
        "plug": [(660, .06), (990, .09)], "unplug": [(990, .06), (660, .09)], "shot": [(1760, .04), (1320, .05)]}
CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "glyph"

# Settings -> Sound -> System sounds:
#   glyph  square-wave beeps, like an old computer (the prototype)
#   soft   gentle sine tones, a bit lower
#   chime  bell-like notes that ring out
#   off    no system sounds
STYLES = ("glyph", "soft", "chime")


def conf(key, default):
    try:
        for line in (CONF / "glyph.conf").read_text().splitlines():
            if line.startswith(key + "="):
                return line.split("=", 1)[1].strip() or default
    except Exception:
        pass
    return default


def tone(style, f, d, rate=44100):
    """One note as 16-bit samples."""
    out = bytearray()
    if style == "soft":
        f *= 0.75
    n = int(rate * (d * 3.5 if style == "chime" else d * 1.3 if style == "soft" else d))
    for i in range(n):
        t = i / rate
        if style == "glyph":
            env = min(1, i / 200) * min(1, (n - i) / 400)
            v = 0.18 * env * (1 if math.sin(2 * math.pi * f * t) > 0 else -1)      # square wave, soft edges
        elif style == "soft":
            env = min(1, i / 900) * min(1, (n - i) / 1800)
            v = 0.32 * env * math.sin(2 * math.pi * f * t)
        else:                                                                       # chime: a bell with overtones
            env = min(1, i / 60) * math.exp(-4.5 * t / (n / rate)) * min(1, (n - i) / 300)
            v = 0.6 * env * (math.sin(2 * math.pi * f * t) + 0.45 * math.sin(2 * math.pi * f * 2.76 * t)
                              + 0.2 * math.sin(2 * math.pi * f * 5.4 * t)) / 1.65
        out += struct.pack("<h", int(max(-1, min(1, v)) * 32767))
    return out


def make(kind, style, path):
    path.parent.mkdir(parents=True, exist_ok=True)
    frames = bytearray()
    notes = SNDS[kind]
    for i, (f, d) in enumerate(notes):
        if style == "chime" and i < len(notes) - 1:
            frames += tone(style, f, d * 0.45)           # quick steps, the last note rings out
        else:
            frames += tone(style, f, d)
    with wave.open(str(path), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(44100)
        w.writeframes(bytes(frames))


def play(path):
    for player in ("pw-play", "paplay", "aplay"):
        if shutil.which(player):
            subprocess.run([player, str(path)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return


if __name__ == "__main__":
    kind = sys.argv[1] if len(sys.argv) > 1 and sys.argv[1] in SNDS else "notify"
    # glyph-sound notify --style chime   (Settings uses this to let you hear a style before you pick it)
    style = sys.argv[3] if len(sys.argv) > 3 and sys.argv[2] == "--style" else conf("sound_style", "glyph")
    if style == "off":
        sys.exit(0)
    # your own sound for messages (Settings -> Sound -> Your own message sound)
    if kind == "notify" and "--style" not in sys.argv:
        own = sorted((CONF / "sounds").glob("notify.*")) if (CONF / "sounds").is_dir() else []
        if own:
            play(own[0])
            sys.exit(0)
    style = style if style in STYLES else "glyph"
    cache = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "glyph" / f"snd2-{style}-{kind}.wav"
    if not cache.exists():
        make(kind, style, cache)
    play(cache)
