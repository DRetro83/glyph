#!/usr/bin/env python3
"""glyph-windows - the "▦ N" button on the taskbar: how many windows are open.

Prints one line of JSON for waybar. Uses lswt (lists Wayland windows); when lswt
is not installed it prints an empty box, so waybar hides it.
  glyph-windows        JSON for waybar
  glyph-windows count  just the number (for the desktop clock)
"""
import json
import shutil
import subprocess
import sys


def windows():
    if not shutil.which("lswt"):
        return None
    try:
        out = subprocess.run(["lswt", "-j"], capture_output=True, text=True, timeout=3).stdout
        data = json.loads(out)
    except Exception:
        return None
    items = data.get("toplevels", data) if isinstance(data, dict) else data
    wins = []
    for t in items if isinstance(items, list) else []:
        if isinstance(t, dict):
            app = (t.get("app-id") or t.get("app_id") or "").lower()
            if app in ("glyph-desk", "glyph-panel", "glyph-start", "waybar"):
                continue
            wins.append(t.get("title") or t.get("app-id") or "window")
    return wins


w = windows()
if len(sys.argv) > 1 and sys.argv[1] == "count":
    print("" if w is None else len(w))
elif w is None:
    print(json.dumps({"text": "▦", "tooltip": "open windows (install lswt)", "class": "none"}))
else:
    print(json.dumps({"text": f"▦ {len(w)}", "tooltip": "\n".join(w) or "no windows open",
                      "class": "some" if w else "none"}))
