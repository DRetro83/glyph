#!/usr/bin/env python3
"""glyph-windows - the "▦ N" button on the taskbar: how many windows are open.

Prints one line of JSON for waybar (click it for the OPEN WINDOWS panel).
  glyph-windows        JSON for waybar
  glyph-windows count  just the number (for the desktop clock)
"""
import json
import subprocess
import sys


def windows():
    try:
        out = subprocess.run(["glyph-toplevel", "list"], capture_output=True, text=True, timeout=3).stdout
        data = json.loads(out or "null")
    except Exception:
        return None
    if data is None:
        return None
    return [t.get("title") or t.get("app_id") or "window" for t in data]


w = windows()
if len(sys.argv) > 1 and sys.argv[1] == "count":
    print("" if w is None else len(w))
elif w is None:
    print(json.dumps({"text": "▦", "tooltip": "open windows", "class": "none"}))
else:
    print(json.dumps({"text": f"▦ {len(w)}", "tooltip": "\n".join(w) or "no windows open",
                      "class": "some" if w else "none"}))
