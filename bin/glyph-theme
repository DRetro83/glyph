snapping.overlay.region.bg.enabled: yes
snapping.overlay.edge.bg.enabled: yes
snapping.overlay.region.bg.color: {p['amber']}33
snapping.overlay.edge.bg.color: {p['amber']}33
snapping.overlay.region.border.width: 2
snapping.overlay.edge.border.width: 2
snapping.overlay.region.border.color: {p['amber']}
snapping.overlay.edge.border.color: {p['amber']}
"""


def shade(h, f):
    """Darker (f < 1) or lighter (f > 1) version of #rrggbb."""
    h = h.lstrip("#")
    c = [min(255, max(0, round(int(h[i:i + 2], 16) * f))) for i in (0, 2, 4)]
    return "#%02x%02x%02x" % tuple(c)


def button_svg(kind, fill, ink):
    """Square coloured buttons like the prototype: _  []  x"""
    glyph = {
        "iconify": '<rect x="5" y="12" width="8" height="2" fill="{ink}"/>',
        "max": '<rect x="5" y="5" width="8" height="8" fill="none" stroke="{ink}" stroke-width="1.6"/>',
        "max_toggled": '<rect x="4" y="6.5" width="6.5" height="6.5" fill="none" stroke="{ink}" stroke-width="1.4"/>'
                       '<path d="M7 6.5V4h7v7h-3" fill="none" stroke="{ink}" stroke-width="1.4"/>',
        "close": '<path d="M5.5 5.5l7 7M12.5 5.5l-7 7" stroke="{ink}" stroke-width="1.8" stroke-linecap="square"/>',
    }[kind].format(ink=ink)
    return ('<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" '
            'shape-rendering="crispEdges">'
            f'<rect x="0.5" y="0.5" width="17" height="17" fill="{fill}" stroke="#0c0b0a" stroke-opacity=".45"/>'
            f'{glyph}</svg>\n')


def write_buttons(p):
    fills = {"iconify": p["olive"], "max": p["green"], "max_toggled": p["green"], "close": p["rose"]}
    for kind, fill in fills.items():
        ink = "#ffffff" if kind == "close" else "#0c0b0a"
        (LABWC_THEME / f"{kind}-active.svg").write_text(button_svg(kind, fill, ink))
        (LABWC_THEME / f"{kind}-inactive.svg").write_text(button_svg(kind, p["hov"], p["dim"]))



def is_light(p):
    h = p["view"].lstrip("#")
    r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
    return (0.299 * r + 0.587 * g + 0.114 * b) > 140


def waybar_css(p):
    light = is_light(p)
    bar = p['panel'] if light else p['lo']                 # the bar itself: light in light mode
    sys_ink = shade(p['title'], 0.55) if light else p['title']   # system colour as text: darker on light
    ws_on = p['title']                                     # the current workspace: the system colour
    return f"""/* Glyph taskbar - made by glyph-theme, do not edit by hand. */
* {{ font-family: "IBM Plex Mono", monospace; font-size: 13px; border-radius: 0; min-height: 0; box-shadow: none; text-shadow: none; }}
window#waybar {{ background: {bar}; color: {p['text']}; border-top: 1px solid {p['hi']}; }}
tooltip {{ background: {p['panel']}; border: 1px solid {p['title']}; }}
tooltip label {{ color: {p['text']}; }}
button {{ border: none; }}

#custom-start {{ color: {sys_ink}; background: {p['view']}; border: 1px solid {sys_ink}; font-weight: bold; letter-spacing: 1px; padding: 0 16px; margin: 4px 6px 4px 8px; }}
#custom-start:hover {{ background: {p['hov']}; }}

#custom-ws1, #custom-ws2, #custom-ws3, #custom-ws4 {{ color: {p['text']}; background: {p['view']}; border: 1px solid {p['hi']}; min-width: 40px; padding: 0; margin: 4px 2px; font-weight: bold; }}
#custom-ws1.active, #custom-ws2.active, #custom-ws3.active, #custom-ws4.active {{ background: {ws_on}; color: {p['tink']}; border-color: {ws_on}; border-bottom: 3px solid {shade(p['title'], 0.6)}; }}
#custom-ws1:hover, #custom-ws2:hover, #custom-ws3:hover, #custom-ws4:hover {{ border-color: {p['title']}; }}
#custom-ws4 {{ margin-right: 8px; }}

#taskbar {{ border-left: 1px solid {p['hi']}; padding-left: 6px; }}
#taskbar button {{ color: {p['text']}; background: {p['view']}; border: 1px solid {p['hi']}; border-bottom: 3px solid {p['hi']}; padding: 0 14px 0 8px; margin: 4px 2px; min-width: 100px; }}
#taskbar button:hover {{ background: {p['hov']}; }}
#taskbar button.active {{ background: {p['hov']}; border-bottom-color: {p['title']}; }}
#taskbar button.minimized {{ color: {p['dim']}; }}

#tray, #custom-windows, #custom-settings, #clock {{ color: {p['text']}; background: {p['view']}; border: 1px solid {p['hi']}; padding: 0 14px; margin: 4px 0 4px -1px; }}
#tray {{ margin-right: 8px; }}
#custom-settings {{ font-weight: bold; letter-spacing: 1px; }}
#custom-settings.low {{ color: {p['amber']}; }}
#clock {{ font-weight: bold; font-size: 16px; padding: 0 22px; letter-spacing: 1px; }}
#custom-power {{ color: {p['amber']}; background: {p['view']}; border: 1px solid {p['hi']}; font-size: 18px; padding: 0 14px; margin: 4px 8px 4px 6px; }}
#custom-power:hover, #custom-settings:hover, #clock:hover {{ background: {p['hov']}; }}
"""


def rgba(h, a="ff"):
    return h.lstrip("#") + a


def fuzzel_version():
    try:
        out = subprocess.run(["fuzzel", "--version"], capture_output=True, text=True).stdout
        return tuple(int(x) for x in out.split("version:")[1].split()[0].split(".")[:2])
    except Exception:
        return (0, 0)


def fuzzel_ini(p):
    """Options that older fuzzel versions refuse are left out for them."""
    v = fuzzel_version()
    newer = (1, 12) if v == (0, 0) else v   # not installed yet: assume Debian 13 (1.12)
    text = fuzzel_ini_full(p).splitlines()
    drop = set()
    if newer < (1, 10):
        drop |= {"anchor", "x-margin", "y-margin"}
    if newer < (1, 12):
        drop |= {"prompt", "input", "placeholder", "counter"}
    keep = [l for l in text if not (l.split("=", 1)[0] in drop and "=" in l and not l.startswith("prompt=\""))]
    return "\n".join(keep) + "\n"


def fuzzel_ini_full(p):
    return f"""# Glyph start menu (fuzzel) - made by glyph-theme, do not edit by hand.
[main]
font=IBM Plex Mono:size=11
prompt="▸ "
icons-enabled=no
terminal=foot -e
width=44
lines=14
horizontal-pad=14
vertical-pad=10
inner-pad=8
line-height=22
letter-spacing=0
anchor=bottom-left
x-margin=6
y-margin=46
layer=overlay
exit-on-keyboard-focus-loss=yes

[colors]
background={rgba(p['panel'])}
text={rgba(p['text'])}
prompt={rgba(p['amber'])}
input={rgba(p['text'])}
placeholder={rgba(p['dim'])}
match={rgba(p['amber'])}
selection={rgba(p['title'])}
selection-text={rgba(p['tink'])}
selection-match={rgba(p['tink'])}
counter={rgba(p['dim'])}
border={rgba(p['title'])}

[border]
width=1
radius=0
"""


def mako_conf(p):
    c = read_conf()
    pos = c.get("notif_pos", "tr")
    anchor = {"t": "top", "b": "bottom"}.get(pos[:1], "top") + "-" + {"r": "right", "l": "left", "c": "center"}.get(pos[1:], "right")
    margin = "10,10,56,10" if pos.startswith("b") else "10"
    try:
        secs = int(c.get("notif_time", "5"))
    except ValueError:
        secs = 5
    sound = "on-notify=exec glyph-sound notify\n" if c.get("notif_sound", "yes") == "yes" else "on-notify=none\n"
    return f"""# Glyph notifications (mako) - made by glyph-theme, do not edit by hand.
# Where and how long: Settings -> Notifications.
font=IBM Plex Mono 11
background-color={p['panel']}
text-color={p['text']}
border-color={p['title']}
progress-color=over {p['hov']}
border-size=1
border-radius=0
padding=10,12
margin={margin}
width=380
max-visible=4
anchor={anchor}
default-timeout={secs * 1000}
icons=0
format=<b>%s</b>\\n%b
{sound}
[urgency=high]
border-color={p['rose']}
border-size=2
default-timeout=0

[mode=do-not-disturb]
invisible=1
on-notify=none
"""


