window.inactive.title.bg.color: {p['win']}

window.active.label.text.color: {p['tink']}
window.inactive.label.text.color: {p['dim']}
window.label.text.justify: left

# Glyph's own labwc (labwc-glyph) also draws fine stripes and the title box;
# standard labwc skips these lines.
window.active.title.bg.stripe.color: {shade(p['title'], 0.80)}
