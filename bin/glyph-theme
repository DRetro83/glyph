def gtklock_css(p):
    light = is_light(p)
    scan = "rgba(0,0,0,0.10)" if light else "rgba(0,0,0,0.28)"
    return f"""/* Glyph lock screen (gtklock) - made by glyph-theme, do not edit by hand. */
window {{
  background-color: {p['panel']};
  background-image: repeating-linear-gradient(to bottom, {scan} 0px, {scan} 1px, transparent 1px, transparent 3px);
  color: {p['text']};
}}
window * {{ font-family: "IBM Plex Mono", monospace; }}
#window-box {{ margin: 40px; }}
.corner {{ min-width: 40px; min-height: 40px; border: 0 solid {p['tan']}; }}
.c1 {{ border-top-width: 2px; border-left-width: 2px; }}
.c2 {{ border-top-width: 2px; border-right-width: 2px; }}
.c3 {{ border-bottom-width: 2px; border-left-width: 2px; }}
.c4 {{ border-bottom-width: 2px; border-right-width: 2px; }}
.locked {{ color: {p['dim']}; font-size: 12px; }}
#clock-label {{ font-size: 180px; font-weight: bold; color: {p['text']}; padding: 0 12px 8px 12px; }}
#date-label {{ font-size: 22px; color: {p['text']}; }}
#body-grid {{ margin-top: 28px; }}
#input-field {{ background: {p['view']}; color: {p['text']}; border: 1px solid {p['hi']}; border-radius: 0;
  box-shadow: none; padding: 8px 12px; min-height: 22px; caret-color: {p['amber']}; font-size: 15px; }}
#input-field:focus {{ border-color: {p['amber']}; }}
#unlock-button {{ background: {p['view']}; background-image: none; color: {p['amber']}; border: 1px solid {p['amber']};
  border-radius: 0; box-shadow: none; text-shadow: none; padding: 8px 16px; font-weight: bold; font-size: 15px; }}
#unlock-button:hover {{ background: {p['hov']}; }}
#error-label {{ color: {p['rosehi']}; font-size: 13px; }}
#warning-label {{ color: {p['amber']}; font-size: 13px; }}
"""


def write_outputs(p):
    gl = CONF_DIR / "gtklock"
    gl.mkdir(parents=True, exist_ok=True)
    (gl / "layout.ui").write_text(GTKLOCK_UI)
    (gl / "style.css").write_text(gtklock_css(p))
    for sub, name, text in (("waybar", "style.css", waybar_css(p)),
                            ("fuzzel", "fuzzel.ini", fuzzel_ini(p)),
                            ("mako", "config", mako_conf(p)),
                            ("swaylock", "config", swaylock_conf(p)),
                            ("panel", "panel.css", panel_css(p))):
        d = CONF_DIR / sub
        d.mkdir(parents=True, exist_ok=True)
        (d / name).write_text(text)

# ---------- step 6: apps in the Glyph look ----------
def gtk_css(p, mode, gtk4=False):
    if gtk4:
        base = "Default-light.css" if mode == "light" else "Default-dark.css"
        imp = f'@import url("resource:///org/gtk/libgtk/theme/Default/{base}");'
    else:
        base = "gtk-contained.css" if mode == "light" else "gtk-contained-dark.css"
        imp = f'@import url("resource:///org/gtk/libgtk/theme/Adwaita/{base}");'
    return f"""/* Glyph GTK theme - made by glyph-theme, do not edit by hand. */
{imp}

* {{ border-radius: 0; font-family: "IBM Plex Mono", monospace; -gtk-outline-radius: 0; }}
window, .background, dialog {{ background-color: {p['view']}; color: {p['text']}; }}
