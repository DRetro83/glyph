#!/usr/bin/env python3
"""glyph-panel - Glyph quick settings and calendar.

  glyph-panel quick     Quick settings (click SETTINGS on the taskbar)
  glyph-panel cal       Calendar and notifications (click the clock)
  glyph-panel power     Lock, log out, sleep, restart, off (click the power button)
  glyph-panel windows   Open windows: go to one, close one, close all (click ▦ N)
  glyph-panel clip      Clipboard history (Super+V): click to paste
  glyph-panel keys      All shortcuts (Super+/)
  glyph-panel media     Now playing: previous, play/pause, next (click ♪ on the taskbar)
  glyph-panel status    one line of JSON for the taskbar button

Running the same panel again closes it. Esc closes it too.
Uses only standard Debian tools: nmcli, bluetoothctl, wpctl, brightnessctl,
powerprofilesctl, udisksctl, makoctl, wlsunset.
"""
import calendar
import datetime
import json
import time
import threading
import os
import re
import shutil
import signal
import subprocess
import sys
from pathlib import Path

CONF = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "glyph"
RUN = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))


# ---------------------------------------------------------------- helpers

OPEN_FILE = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "glyph" / "quick-open"


def load_open():
    try:
        return set(OPEN_FILE.read_text().split())
    except Exception:
        return set()


def save_open(keys):
    try:
        OPEN_FILE.write_text(" ".join(sorted(keys)) + "\n")
    except Exception:
        pass

def sh(cmd, timeout=4):
    """Run a command, return its output ('' on any problem)."""
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def bg(cmd):
    """Start a command and forget about it."""
    try:
        subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    except Exception:
        pass


def has(prog):
    return shutil.which(prog) is not None


def nmcli_split(line):
    """nmcli -t escapes ':' inside values as '\\:'."""
    out, cur, esc = [], "", False
    for ch in line:
        if esc:
            cur += ch
            esc = False
        elif ch == "\\":
            esc = True
        elif ch == ":":
            out.append(cur)
            cur = ""
        else:
            cur += ch
    out.append(cur)
    return out


# ---------------------------------------------------------------- system state
def wifi_on():
    return sh(["nmcli", "-t", "-f", "WIFI", "radio"]).strip() == "enabled"


def wifi_current():
    for l in sh(["nmcli", "-t", "-f", "ACTIVE,SSID", "dev", "wifi"]).splitlines():
        f = nmcli_split(l)
        if f and f[0] == "yes":
            return f[1] if len(f) > 1 else ""
    return ""


def wired_up():
    for l in sh(["nmcli", "-t", "-f", "TYPE,STATE", "dev"]).splitlines():
        f = nmcli_split(l)
        if len(f) > 1 and f[0] == "ethernet" and f[1].startswith("connected"):
            return True
    return False


def wifi_list():
    nets = {}
    for l in sh(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list", "--rescan", "no"]).splitlines():
        f = nmcli_split(l)
        if len(f) < 4 or not f[1]:
            continue
        ssid, sig = f[1], int(f[2] or 0)
        cur = f[0].strip() == "*"
        if ssid not in nets or sig > nets[ssid]["sig"] or cur:
            nets[ssid] = {"ssid": ssid, "sig": sig, "lock": f[3] not in ("", "--"), "cur": cur or nets.get(ssid, {}).get("cur", False)}
    known = set(sh(["nmcli", "-t", "-f", "NAME", "con", "show"]).splitlines())
    lst = sorted(nets.values(), key=lambda n: (not n["cur"], n["ssid"] not in known, -n["sig"]))
    for n in lst:
        n["known"] = n["ssid"] in known
    return lst[:10]


def bt_present():
    return has("bluetoothctl") and "Controller" in sh(["bluetoothctl", "list"])


def bt_on():
    return "Powered: yes" in sh(["bluetoothctl", "show"])


def bt_devices():
    out = sh(["bluetoothctl", "devices", "Paired"]) or sh(["bluetoothctl", "paired-devices"])
    devs = []
    for l in out.splitlines():
        m = re.match(r"Device ([0-9A-F:]{17}) (.+)", l.strip())
        if m:
            info = sh(["bluetoothctl", "info", m.group(1)])
            devs.append({"mac": m.group(1), "name": m.group(2), "on": "Connected: yes" in info})
    return devs


def modem_present():
    return any(nmcli_split(l)[0] == "gsm" for l in sh(["nmcli", "-t", "-f", "TYPE", "dev"]).splitlines())


def wwan_on():
    return sh(["nmcli", "-t", "-f", "WWAN", "radio"]).strip() == "enabled"


def dnd_on():
    return "do-not-disturb" in sh(["makoctl", "mode"])


def night_on():
    return sh(["pgrep", "-x", "wlsunset"]).strip() != ""


def airplane_on():
    return sh(["nmcli", "-t", "-f", "WIFI", "radio"]).strip() == "disabled" and not (bt_present() and bt_on())


def volume():
    out = sh(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"])
    m = re.search(r"([\d.]+)", out)
    return (round(float(m.group(1)) * 100) if m else None), ("MUTED" in out)


def brightness():
    if not has("brightnessctl"):
        return None
    for l in sh(["brightnessctl", "-m", "-c", "backlight"]).splitlines():
        f = l.split(",")
        if len(f) >= 4:
            return int(f[3].rstrip("%"))
    return None


def power_profile():
    return sh(["powerprofilesctl", "get"]).strip() if has("powerprofilesctl") else ""


def battery():
    for b in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        try:
            cap = int((b / "capacity").read_text())
            st = (b / "status").read_text().strip()
            return cap, st
        except Exception:
            pass
    return None


def device_batteries():
    """Batteries of mice, keyboards, controllers, headsets ... via UPower."""
    if not has("upower"):
        return []
    out = []
    for path in sh(["upower", "-e"]).split():
        if "DisplayDevice" in path or "line_power" in path:
            continue
        info = sh(["upower", "-i", path])
        pct = re.search(r"percentage:\s+([\d.]+)%", info)
        if not pct:
            continue
        name = (re.search(r"model:\s+(.+)", info) or re.search(r"native-path:\s+(.+)", info))
        state = re.search(r"state:\s+(\S+)", info)
        kind = re.search(r"^\s{2}(\S[\w-]*)\n", info, re.M)
        nm = name.group(1).strip() if name else path.rsplit("/", 1)[-1]
        if "battery_BAT" in path:
            nm = "This computer"
        st = state.group(1) if state else ""
        st = {"fully-charged": "full", "pending-charge": "waiting", "discharging": ""}.get(st, st)
        out.append({"name": nm, "pct": int(float(pct.group(1))), "state": st, "kind": kind.group(1) if kind else ""})
    return out


CLEARED = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "glyph-notif-cleared"


def cleared_ids():
    try:
        return set(CLEARED.read_text().split())
    except Exception:
        return set()


def notif_history():
    """[(id, app, summary, body)]: the notifications on screen now, then mako's history."""
    seen, out = set(), []
    for cmd in ("list", "history"):
        for it in _mako_items(sh(["makoctl", cmd])):
            if str(it[0]) not in seen:
                seen.add(str(it[0]))
                out.append(it)
    out.sort(key=lambda i: -int(i[0]) if str(i[0]).isdigit() else 0)
    return out


def _mako_items(raw):
    items = []
    try:
        data = json.loads(raw)
        lst = data.get("data", [[]])[0] if isinstance(data, dict) else data
        for n in lst:
            g = lambda k: (n.get(k, {}).get("data", "") if isinstance(n.get(k), dict) else n.get(k, ""))
            items.append((g("id"), g("app-name") or g("app_name"), g("summary"), g("body")))
    except Exception:
        cur = None
        for l in raw.splitlines():
            m = re.match(r"Notification (\d+): (.*)", l)
            if m:
                cur = [m.group(1), "", m.group(2), ""]
                items.append(cur)
            elif cur is not None and l.strip().startswith("App name:"):
                cur[1] = l.split(":", 1)[1].strip()
            elif cur is not None and l.strip().startswith("Body:"):
                cur[3] = l.split(":", 1)[1].strip()
    return [tuple(i) for i in items]


DDC_CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "glyph-ddc"


def ddc_brightness_cached():
    """Last known brightness of an external monitor (DDC/CI is slow, so cached)."""
    try:
        return int(DDC_CACHE.read_text().strip())
    except Exception:
        return None


def ddc_read():
    out = sh(["ddcutil", "getvcp", "10", "--brief", "--sleep-multiplier", "0.4"], timeout=8)
    m = re.search(r"VCP 10 C (\d+) (\d+)", out)
    if m:
        v = round(int(m.group(1)) * 100 / max(1, int(m.group(2))))
        try:
            DDC_CACHE.write_text(str(v))
        except Exception:
            pass
        return v
    return None


def drives():
    try:
        data = json.loads(sh(["lsblk", "-J", "-o", "NAME,PATH,LABEL,SIZE,MOUNTPOINT,RM,HOTPLUG,TYPE,FSTYPE,PKNAME"]))
    except Exception:
        return []
    out = []

    def walk(devs, parent_removable=False):
        for d in devs:
            removable = parent_removable or d.get("rm") in (True, "1") or d.get("hotplug") in (True, "1")
            if removable and d.get("fstype") and d.get("type") in ("part", "disk"):
                out.append({"path": d["path"], "label": d.get("label") or d["name"], "size": d.get("size", ""),
                            "mnt": d.get("mountpoint"), "parent": "/dev/" + (d.get("pkname") or d["name"])})
            walk(d.get("children", []), removable)
    walk(data.get("blockdevices", []))
    return out


# ---------------------------------------------------------------- taskbar status
# ---- quick settings ask many tools (nmcli, bluetoothctl, upower ...). They are asked in a
# background thread and kept here, so the panel draws instantly and Show/Hide never waits.
_SLOW = ["wifi_on", "wifi_current", "wired_up", "wifi_list", "bt_present", "bt_on", "bt_devices",
         "modem_present", "wwan_on", "dnd_on", "night_on", "airplane_on", "volume", "brightness",
         "power_profile", "battery", "device_batteries", "drives"]
_RAW, _CACHE = {}, {}
QS_CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "glyph-quick.json"
ENDW = 64   # width of Show/Hide, MUTE and the space after the brightness slider
_LOCK = threading.Lock()


def _cached(name):
    def w():
        with _LOCK:
            if name in _CACHE:
                return _CACHE[name]
        v = _RAW[name]()
        with _LOCK:
            _CACHE[name] = v
        return v
    return w


def use_cache():
    g = globals()
    for n in _SLOW:
        if n not in _RAW:
            _RAW[n] = g[n]
            g[n] = _cached(n)


def _plain(v):
    return json.loads(json.dumps(v))   # tuples become lists, like after loading


def load_saved_cache():
    try:
        data = json.loads(QS_CACHE.read_text())
        with _LOCK:
            for k, v in data.items():
                if k in _SLOW:
                    _CACHE[k] = tuple(v) if k == "volume" and isinstance(v, list) else v
        return True
    except Exception:
        return False


def refresh_cache():
    """Ask all the tools again; returns True when something changed."""
    new = {}
    for n in _SLOW:
        try:
            v = _RAW[n]()
        except Exception:
            v = None
        new[n] = tuple(v) if n == "volume" and isinstance(v, (list, tuple)) else _plain(v)
    with _LOCK:
        changed = any(_CACHE.get(k) != v for k, v in new.items())
        _CACHE.update(new)
    try:
        QS_CACHE.write_text(json.dumps(new))
    except Exception:
        pass
    return changed


def open_windows():
    """[(app_id, title, state)] with state 'on screen', 'minimized' or 'behind'.
    Uses glyph-toplevel. GLYPH_FAKE_WINDOWS='app|title|state;...' is for testing."""
    fake = os.environ.get("GLYPH_FAKE_WINDOWS")
    if fake:
        return [tuple(x.split("|")) for x in fake.split(";") if x]
    try:
        data = json.loads(sh(["glyph-toplevel", "list"], 3) or "null")
    except Exception:
        return None
    if data is None:
        return None
    out = [(t.get("app_id", ""), t.get("title") or t.get("app_id") or "window", t.get("state", "behind")) for t in data]
    out.sort(key=lambda w: ("on screen", "behind", "minimized").index(w[2]) if w[2] in ("on screen", "behind", "minimized") else 1)
    return out


def app_name(app, title):
    """A short, readable name: 'org.gnome.Nautilus' -> 'Nautilus', 'glyph-files' -> 'Files'."""
    a = app.split(".")[-1] if app else title
    a = re.sub(r"^glyph-", "", a)
    nice = {"xfce4-terminal": "Terminal", "foot": "Terminal", "firefox-esr": "Firefox",
            "libreoffice-writer": "Writer", "libreoffice-calc": "Calc", "org.inkscape.inkscape": "Inkscape"}
    a = nice.get(app.lower(), a)
    return (a[:1].upper() + a[1:]) if a else "Window"


def window_do(action, app, title):
    """focus or close one window."""
    bg(["glyph-toplevel", action, app, title])
    return True


def status():
    txt = "SETTINGS ▴"
    tips = []
    usb = len([d for d in drives() if d["mnt"]])
    if usb:
        txt += f"  USB {usb}"
    b = battery()
    if b:
        tips.append(f"Battery {b[0]}% · {b[1].lower()}")
        if b[0] <= 20 and b[1] != "Charging":
            txt += f"  BAT {b[0]}%"
    w = wifi_current()
    tips.append("Wi-Fi: " + (w if w else ("wired" if wired_up() else "not connected")))
    v, m = volume()
    if v is not None:
        tips.append("Volume: " + ("muted" if m else f"{v}%"))
    if dnd_on():
        txt += "  DND"
    print(json.dumps({"text": txt, "tooltip": "\n".join(tips), "class": "low" if (b and b[0] <= 20) else ""}))


# ---------------------------------------------------------------- the panel window

def add_catcher(on_click):
    """A see-through layer over the desktop and the windows (not the taskbar), just below a menu:
    a click anywhere next to the menu closes it, like on other desktops."""
    from gi.repository import Gdk, Gtk, GtkLayerShell
    c = Gtk.Window()
    c.set_name("glyph-catcher")
    GtkLayerShell.init_for_window(c)
    GtkLayerShell.set_namespace(c, "glyph-catcher")
    GtkLayerShell.set_layer(c, GtkLayerShell.Layer.TOP)
    for e in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.BOTTOM, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
        GtkLayerShell.set_anchor(c, e, True)
    GtkLayerShell.set_exclusive_zone(c, 0)          # leave the taskbar free
    try:
        GtkLayerShell.set_keyboard_mode(c, GtkLayerShell.KeyboardMode.NONE)
    except Exception:
        pass
    vis = c.get_screen().get_rgba_visual()
    if vis:
        c.set_visual(vis)
    c.set_app_paintable(True)
    c.connect("draw", lambda w, cr: (cr.set_source_rgba(0, 0, 0, 0), cr.set_operator(0), cr.paint(), False)[3])
    c.add_events(Gdk.EventMask.BUTTON_PRESS_MASK)
    c.connect("button-press-event", lambda *_: (on_click(), True)[1])
    c.show_all()
    return c


PANEL_KINDS = ("quick", "cal", "power", "windows", "clip", "keys", "media")

SHORTCUTS = [("Super  or  Ctrl+Space", "Start menu"), ("Super+V", "Clipboard history"), ("Super+/", "These shortcuts"),
             ("Ctrl+Alt+T", "Terminal"), ("Super+E", "Files"), ("Ctrl+Shift+Esc", "System monitor"),
             ("Ctrl+Alt+1 … 4", "Go to workspace 1 … 4"), ("Ctrl+Alt+Shift+1 … 4", "Move the window to workspace 1 … 4"),
             ("Alt+Tab", "Switch windows"), ("Super+Arrows", "Snap a window to a side"), ("Alt+F4", "Close the window"),
             ("Print", "Screenshot of the screen"), ("Shift+Print  or  Ctrl+Alt+P", "Screenshot of an area"),
             ("Ctrl+Alt+L", "Lock the screen"), ("Volume / brightness keys", "Louder, softer, brighter")]


def audio_devices(kind):
    """kind sinks (speakers, headphones, HDMI) or sources (microphones):
    [(name, description, is_default, muted)] via pactl (works with PipeWire)."""
    if not has("pactl"):
        return []
    default = sh(["pactl", "get-default-sink" if kind == "sinks" else "get-default-source"]).strip()
    try:
        data = json.loads(sh(["pactl", "-f", "json", "list", kind]) or "[]")
    except Exception:
        return []
    out = []
    for d in data:
        name = d.get("name", "")
        if kind == "sources" and (name.endswith(".monitor") or d.get("monitor_source") == "" and ".monitor" in name):
            continue           # the "what you hear" copies of the speakers
        desc = d.get("description") or name
        out.append((name, desc, name == default, bool(d.get("mute"))))
    return out


def media_players():
    """[(player, status, title, artist)] from playerctl; the playing one first."""
    if not has("playerctl"):
        return []
    out = []
    for pl in sh(["playerctl", "-l"]).split():
        st = sh(["playerctl", "-p", pl, "status"]).strip()
        meta = sh(["playerctl", "-p", pl, "metadata", "--format", "{{title}}\t{{artist}}"]).strip().split("\t")
        if st in ("Playing", "Paused"):
            out.append((pl, st, meta[0] if meta else "", meta[1] if len(meta) > 1 else ""))
    out.sort(key=lambda x: x[1] != "Playing")
    return out


def run_panel(kind):
    import gi
    gi.require_version("Gtk", "3.0")
    gi.require_version("Gdk", "3.0")
    gi.require_version("GtkLayerShell", "0.1")
    from gi.repository import Gdk, GLib, Gtk, GtkLayerShell
    GLib.set_prgname("glyph-panel")

    pidfile = RUN / f"glyph-panel-{kind}.pid"
    others = [RUN / f"glyph-panel-{k}.pid" for k in PANEL_KINDS if k != kind]
    def panel_pid(f):
        """The pid in f, but only if that process really is a glyph-panel."""
        try:
            pid = int(f.read_text())
            if b"glyph-panel" in Path(f"/proc/{pid}/cmdline").read_bytes():
                return pid
        except Exception:
            pass
        f.unlink(missing_ok=True)
        return None

    for f, toggle in [(pidfile, True)] + [(o, False) for o in others]:
        pid = panel_pid(f)
        if pid and toggle:
            try:
                if time.time() - f.stat().st_mtime < 1.5:
                    return          # it is still opening: ignore the double click
            except Exception:
                pass
        if pid:
            try:
                os.kill(pid, signal.SIGTERM)
            except Exception:
                pass
            f.unlink(missing_ok=True)
            if toggle:
                return
    pidfile.write_text(str(os.getpid()))

    css = Gtk.CssProvider()
    try:
        css.load_from_path(str(CONF / "panel" / "panel.css"))
    except Exception:
        pass
    screen = Gdk.Screen.get_default()
    if screen is None:
        pidfile.unlink(missing_ok=True)
        sys.exit("glyph-panel: no display (is Glyph running?)")
    Gtk.StyleContext.add_provider_for_screen(screen, css, Gtk.STYLE_PROVIDER_PRIORITY_USER + 10)

    win = Gtk.Window()
    win.set_name("glyph-panel")
    GtkLayerShell.init_for_window(win)
    GtkLayerShell.set_namespace(win, "glyph-panel")
    GtkLayerShell.set_layer(win, GtkLayerShell.Layer.OVERLAY)
    centred = kind in ("clip", "keys")
    if not centred:
        GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.BOTTOM, True)
        GtkLayerShell.set_anchor(win, GtkLayerShell.Edge.RIGHT, True)
    # with shadows the window is 8px bigger down and right (room for the shadow);
    # move it so the panel itself still touches the taskbar
    sh_on = "shadows=no" not in (CONF / "theme.conf").read_text() if (CONF / "theme.conf").exists() else True
    GtkLayerShell.set_margin(win, GtkLayerShell.Edge.BOTTOM, 0)
    GtkLayerShell.set_margin(win, GtkLayerShell.Edge.RIGHT, 0 if sh_on else 8)
    try:
        GtkLayerShell.set_keyboard_mode(win, GtkLayerShell.KeyboardMode.EXCLUSIVE if centred else
                                        GtkLayerShell.KeyboardMode.ON_DEMAND)
    except Exception:
        GtkLayerShell.set_keyboard_interactivity(win, True)

    def quit_(*_):
        pidfile.unlink(missing_ok=True)
        Gtk.main_quit()

    win.connect("destroy", quit_)
    win.connect("key-press-event", lambda w, e: quit_() if e.keyval == Gdk.KEY_Escape else False)
    add_catcher(quit_)
    had_focus = {"v": False}

    def on_focus_in(*_):
        had_focus["v"] = True

    def on_focus_out(*_):
        if had_focus["v"]:
            GLib.timeout_add(150, lambda: (quit_(), False)[1])
    win.connect("focus-in-event", on_focus_in)
    win.connect("focus-out-event", on_focus_out)
    signal.signal(signal.SIGTERM, lambda *a: GLib.idle_add(quit_))

    outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    outer.get_style_context().add_class("panel")
    win.add(outer)
    title = Gtk.Box()
    title.get_style_context().add_class("ptitle")
    lab = Gtk.Label(label={"quick": "■ QUICK SETTINGS", "power": "■ POWER", "windows": "■ OPEN WINDOWS",
                           "clip": "■ CLIPBOARD", "keys": "■ SHORTCUTS", "media": "■ NOW PLAYING"}.get(kind, "■ CALENDAR"))
    lab.get_style_context().add_class("pt")
    lab.set_valign(Gtk.Align.CENTER)
    title.pack_start(lab, False, False, 0)
    x = Gtk.Button(label="×")
    x.get_style_context().add_class("px")
    x.connect("clicked", quit_)
    title.pack_end(x, False, False, 0)
    if kind == "quick":
        _bat = battery()
        if _bat:
            bl = Gtk.Label(label=f"{'⚡ ' if _bat[1].lower() == 'charging' else ''}{_bat[0]}%")
            bl.get_style_context().add_class("pbat")
            bl.set_valign(Gtk.Align.CENTER)
            title.pack_end(bl, False, False, 6)
    outer.pack_start(title, False, False, 0)
    scroll = Gtk.ScrolledWindow()
    scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
    mon = Gdk.Display.get_default().get_monitor(0)
    max_h = int(mon.get_geometry().height * 0.78) - 90 if mon else 700

    def fit_height():
        """Grow with the content up to most of the screen, then scroll."""
        nat = body.get_preferred_height()[1]
        scroll.set_min_content_height(min(nat, max_h))
        return False
    outer.pack_start(scroll, True, True, 0)
    body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    body.get_style_context().add_class("pbody")
    scroll.add(body)
    foot = Gtk.Box(spacing=6, homogeneous=True)
    foot.get_style_context().add_class("pfoot")
    outer.pack_start(foot, False, False, 0)

    osd_last = {"t": 0.0}

    def osd(kind, value):
        now = time.time()
        if now - osd_last["t"] > 0.12:
            osd_last["t"] = now
            bg(["glyph-osd", kind, str(int(value))])

    def endspace():
        e = Gtk.Box()
        e.set_size_request(ENDW, -1)
        return e

    def short(lab, chars=16):
        lab.set_ellipsize(3)
        lab.set_max_width_chars(chars)
        lab.set_width_chars(1)
        return lab

    def tile_label(ch):
        t = Gtk.Label(label=ch)
        t.set_xalign(0.5)
        t.set_yalign(0.5)
        t.set_justify(Gtk.Justification.CENTER)
        t.set_valign(Gtk.Align.CENTER)
        t.set_halign(Gtk.Align.CENTER)
        t.get_style_context().add_class("tile")
        return t

    def label(text, cls=None, xalign=0, wrap=False):
        l = Gtk.Label(label=text, xalign=xalign)
        if wrap:
            l.set_line_wrap(True)
            l.set_max_width_chars(40)
        if cls:
            for c in cls.split():
                l.get_style_context().add_class(c)
        return l

    def button(text, cb, cls=None):
        b = Gtk.Button(label=text)
        if cls:
            for c in cls.split():
                b.get_style_context().add_class(c)
        b.connect("clicked", lambda *_: cb())
        return b

    def clear(box):
        for c in box.get_children():
            box.remove(c)

    def later(fn, ms=600):
        GLib.timeout_add(ms, lambda: (fn(), False)[1])

    def run_then(cmd, after=None):
        """Run a command in the background; redraw when it finishes."""
        try:
            p = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        except Exception:
            return

        def poll():
            if p.poll() is None:
                return True
            if after:
                after(p.returncode, p.stderr.read() if p.stderr else "")
            return False
        GLib.timeout_add(250, poll)

    # ------------------------------------------------------------ quick settings
    if kind == "quick":
        win.set_size_request(400, -1)
        state = {"open": load_open(), "join": None, "msg": "", "busy": set()}

        state["open"] = set(list(state["open"])[:1])     # one open at a time

        def toggle_tile(name, on, sub, cb, enabled=True, icon=None, more=None):
            """A tile: icon, name, state; on = filled in the system colour; › opens its details."""
            b = Gtk.Button()
            b.get_style_context().add_class("tog")
            if on:
                b.get_style_context().add_class("on")
            h = Gtk.Box(spacing=10)
            if icon:
                ib = Gtk.Box()
                ib.get_style_context().add_class("tico")
                img = Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR)
                ib.set_center_widget(img)
                ib.set_size_request(30, 30)
                ib.set_valign(Gtk.Align.CENTER)
                h.pack_start(ib, False, False, 0)
            v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            v.set_valign(Gtk.Align.CENTER)
            v.pack_start(label(name, "tn"), False, False, 0)
            sl = label(sub, "ts")
            sl.set_ellipsize(3)
            sl.set_max_width_chars(14)
            v.pack_start(sl, False, False, 0)
            h.pack_start(v, True, True, 0)
            if more:
                mb = Gtk.Button(label="›")
                mb.get_style_context().add_class("tmore")
                mb.set_tooltip_text("Details")
                mb.connect("clicked", lambda *_: (state.update(open={more}), save_open({more}), draw()))
                h.pack_end(mb, False, False, 0)
            b.add(h)
            b.set_sensitive(enabled)
            b.connect("clicked", lambda *_: cb())
            return b

        def section(title, key, summary="", extra=None):
            """A header with Show/Hide; returns True when the section is open."""
            flush()
            if state.get("accbox") is None:
                # all details in one framed list, one open at a time
                state["accbox"] = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                state["accbox"].get_style_context().add_class("accbox")
                body.pack_start(state["accbox"], False, False, 0)
            accbox = state["accbox"]
            is_open = key in state["open"]
            hb = Gtk.Button()
            hb.get_style_context().add_class("acc")
            if is_open:
                hb.get_style_context().add_class("open")
            hdr = Gtk.Box(spacing=8)
            tl = label(title, "lab")
            tl.set_width_chars(14)
            hdr.pack_start(tl, False, False, 0)
            sm = label(summary or "", "accsum")
            sm.set_ellipsize(3)
            sm.set_xalign(1)
            hdr.pack_start(sm, True, True, 0)
            hdr.pack_start(label("▾" if is_open else "▸", "dim"), False, False, 0)
            hb.add(hdr)

            def flip():
                state["open"] = set() if is_open else {key}
                save_open(state["open"])
                draw()
            hb.connect("clicked", lambda *_: flip())
            accbox.pack_start(hb, False, False, 0)
            if is_open:
                # the section's content goes in its own box under the header
                state["accopen"] = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                state["accopen"].get_style_context().add_class("accbody")
                accbox.pack_start(state["accopen"], False, False, 0)
                state["mark"] = len(body.get_children())
            return is_open

        def flush():
            """Move what an open section put in the panel into its place in the list."""
            if state.get("accopen") is not None and state.get("mark") is not None:
                for k in body.get_children()[state["mark"]:]:
                    body.remove(k)
                    state["accopen"].pack_start(k, False, False, 0)
            state["accopen"], state["mark"] = None, None

        def draw():
            clear(body)
            state["accbox"], state["accopen"], state["mark"] = None, None, None
            # toggles
            grid = Gtk.Grid(column_spacing=6, row_spacing=6, column_homogeneous=True)
            tiles = []
            w_on = wifi_on()
            cur = wifi_current()
            tiles.append(toggle_tile("Wi-Fi", w_on, (cur or ("wired" if wired_up() else "not connected")) if w_on else "off",
                                     lambda: (sh(["nmcli", "radio", "wifi", "off" if w_on else "on"]), later(draw)),
                                     icon="network-wireless-symbolic", more="net"))
            if bt_present():
                b_on = bt_on()
                tiles.append(toggle_tile("Bluetooth", b_on, "on" if b_on else "off",
                                         lambda: (sh(["bluetoothctl", "power", "off" if b_on else "on"]), later(draw)),
                                         icon="bluetooth-active-symbolic", more="bt"))
            else:
                tiles.append(toggle_tile("Bluetooth", False, "not found", lambda: None, False, icon="bluetooth-disabled-symbolic"))
            if modem_present():
                m_on = wwan_on()
                tiles.append(toggle_tile("Mobile data", m_on, "on" if m_on else "off",
                                         lambda: (sh(["nmcli", "radio", "wwan", "off" if m_on else "on"]), later(draw)),
                                         icon="network-cellular-symbolic"))
            d_on = dnd_on()
            tiles.append(toggle_tile("Do not disturb", d_on, "on" if d_on else "off",
                                     lambda: (sh(["makoctl", "mode", "-t", "do-not-disturb"]), later(draw, 150)),
                                     icon="notifications-disabled-symbolic"))
            if has("wlsunset"):
                n_on = night_on()
                tiles.append(toggle_tile("Night light", n_on, "warm at night" if n_on else "off",
                                         lambda: (sh(["glyph-night", "off" if n_on else "on"]), later(draw)),
                                         icon="night-light-symbolic"))
            a_on = airplane_on()

            def airplane():
                if a_on:
                    sh(["nmcli", "radio", "all", "on"])
                    if bt_present():
                        sh(["bluetoothctl", "power", "on"])
                else:
                    sh(["nmcli", "radio", "all", "off"])
                    if bt_present():
                        sh(["bluetoothctl", "power", "off"])
                later(draw)
            tiles.append(toggle_tile("Airplane", a_on, "on" if a_on else "off", airplane, icon="airplane-mode-symbolic"))
            prof = power_profile()
            if prof:
                order = ["power-saver", "balanced", "performance"]
                nxt = order[(order.index(prof) + 1) % 3] if prof in order else "balanced"
                pnames = {"power-saver": "Saver", "balanced": "Balanced", "performance": "Performance"}
                tiles.append(toggle_tile("Power", prof != "power-saver", pnames.get(prof, prof),
                                         lambda: (sh(["powerprofilesctl", "set", nxt]), later(draw, 200)),
                                         icon={"power-saver": "power-profile-power-saver-symbolic",
                                               "performance": "power-profile-performance-symbolic"}.get(prof, "power-profile-balanced-symbolic")))
            for i, t in enumerate(tiles):
                grid.attach(t, i % 2, i // 2, 1, 1)
            grid.get_style_context().add_class("tiles")
            body.pack_start(grid, False, False, 0)

            # now playing: a card, only when something plays
            ps = media_players()
            if ps:
                pl, st, ti, ar = ps[0]
                card = Gtk.Box(spacing=12)
                card.get_style_context().add_class("npcard")
                note = Gtk.Label(label="♪")
                note.get_style_context().add_class("npnote")
                note.set_size_request(40, 40)
                note.set_valign(Gtk.Align.CENTER)
                card.pack_start(note, False, False, 0)
                v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                v.set_valign(Gtk.Align.CENTER)
                tl = label(ti or pl, "tn")
                tl.set_ellipsize(3)
                tl.set_max_width_chars(20)
                v.pack_start(tl, False, False, 0)
                al = label((ar + " · " if ar else "") + pl.split(".")[0], "dim")
                al.set_ellipsize(3)
                al.set_max_width_chars(22)
                v.pack_start(al, False, False, 0)
                card.pack_start(v, True, True, 0)
                for sym, cmd, cls in (("⏮", "previous", "npbtn"), ("⏸" if st == "Playing" else "▶", "play-pause", "npbtn npmain"),
                                      ("⏭", "next", "npbtn")):
                    nb = button(sym, lambda c=cmd, p=pl: (sh(["playerctl", "-p", p, c]), later(draw, 300)), cls)
                    nb.set_valign(Gtk.Align.CENTER)
                    card.pack_start(nb, False, False, 0)
                body.pack_start(card, False, False, 0)

            # Wi-Fi networks
            if section("WI-FI NETWORKS", "net", cur if w_on and cur else ("off" if not w_on else "")):
                if not w_on:
                    body.pack_start(label("Wi-Fi is off.", "dim"), False, False, 0)
                else:
                    sh(["nmcli", "dev", "wifi", "rescan"], timeout=2)
                    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                    box.get_style_context().add_class("list")
                    for n in wifi_list():
                        r = Gtk.Box(spacing=8)
                        r.get_style_context().add_class("row")
                        bars = "▮" * max(1, round(n["sig"] / 25)) + "▯" * (4 - max(1, round(n["sig"] / 25)))
                        r.pack_start(label(bars, "sig"), False, False, 0)
                        nm = short(label(n["ssid"] + ("  ✓" if n["cur"] else ""), "on" if n["cur"] else None), 22)
                        nm.set_ellipsize(3)
                        r.pack_start(nm, True, True, 0)
                        if n["ssid"] in state["busy"]:
                            r.pack_end(label("…", "amber"), False, False, 0)
                        elif n["cur"]:
                            def disc(s=n["ssid"]):
                                state["busy"].add(s)
                                run_then(["nmcli", "con", "down", "id", s], lambda rc, err, s=s: (state["busy"].discard(s), draw()))
                                draw()
                            r.pack_end(button("Disconnect", disc, "small"), False, False, 0)
                        else:
                            def connect(n=n):
                                if n["known"] or not n["lock"]:
                                    state["busy"].add(n["ssid"])
                                    cmd = ["nmcli", "con", "up", "id", n["ssid"]] if n["known"] else ["nmcli", "dev", "wifi", "connect", n["ssid"]]
                                    run_then(cmd, lambda rc, err, s=n["ssid"]: (state["busy"].discard(s), state.update(msg="" if rc == 0 else "Could not connect to " + s), draw()))
                                else:
                                    state["join"] = n["ssid"]
                                draw()
                            r.pack_end(button("Connect", connect, "small"), False, False, 0)
                        box.pack_start(r, False, False, 0)
                        if state["join"] == n["ssid"]:
                            jr = Gtk.Box(spacing=6)
                            ent = Gtk.Entry()
                            ent.set_visibility(False)
                            ent.set_placeholder_text("password for " + n["ssid"])

                            def join(e=ent, s=n["ssid"]):
                                pw = e.get_text()
                                if not pw:
                                    return
                                state["busy"].add(s)
                                state["join"] = None
                                run_then(["nmcli", "dev", "wifi", "connect", s, "password", pw],
                                         lambda rc, err, s=s: (state["busy"].discard(s), state.update(msg="" if rc == 0 else "Wrong password or no signal: " + s), draw()))
                                draw()
                            ent.connect("activate", lambda *_: join())
                            jr.pack_start(ent, True, True, 0)
                            jr.pack_start(button("Join", join, "small amber"), False, False, 0)
                            jr.pack_start(button("×", lambda: (state.update(join=None), draw()), "small"), False, False, 0)
                            box.pack_start(jr, False, False, 0)
                            GLib.idle_add(ent.grab_focus)
                    body.pack_start(box, False, False, 0)
                    if state["msg"]:
                        body.pack_start(label(state["msg"], "err", wrap=True), False, False, 0)
                    body.pack_start(button("All networks in Settings…", lambda: (bg(["glyph-settings", "Network"]), quit_()), "small"), False, False, 0)

            # Bluetooth devices
            if bt_present() and bt_on():
                devs = bt_devices()
                nconn = len([d for d in devs if d["on"]])
                if section("BLUETOOTH · PAIRED", "bt", f"{nconn} connected" if nconn else f"{len(devs)} paired"):
                    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                    box.get_style_context().add_class("list")
                    if not devs:
                        box.pack_start(label("No paired devices yet.", "dim"), False, False, 0)
                    for d in devs:
                        r = Gtk.Box(spacing=8)
                        r.get_style_context().add_class("row")
                        r.pack_start(tile_label(d["name"][:1].upper()), False, False, 0)
                        r.pack_start(short(label(d["name"] + ("  ✓" if d["on"] else ""), "on" if d["on"] else None), 22), True, True, 0)
                        if d["mac"] in state["busy"]:
                            r.pack_end(label("…", "amber"), False, False, 0)
                        else:
                            act = "disconnect" if d["on"] else "connect"

                            def bt_act(m=d["mac"], a=act):
                                state["busy"].add(m)
                                run_then(["bluetoothctl", a, m], lambda rc, err, m=m: (state["busy"].discard(m), draw()))
                                draw()
                            r.pack_end(button(act.capitalize(), bt_act, "small"), False, False, 0)
                        box.pack_start(r, False, False, 0)
                    body.pack_start(box, False, False, 0)
                    body.pack_start(button("Search and pair a new device…", lambda: (bg(["glyph-settings", "Bluetooth"]), quit_()), "small"), False, False, 0)

            # drives
            dl = drives()
            if section("DRIVES · USB", "usb", f"{len(dl)} plugged in" if dl else "none"):
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                box.get_style_context().add_class("list")
                if not dl:
                    box.pack_start(label("No USB drives plugged in.", "dim"), False, False, 0)
                for d in dl:
                    r = Gtk.Box(spacing=8)
                    r.get_style_context().add_class("row")
                    r.pack_start(tile_label("U"), False, False, 0)
                    v2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                    v2.pack_start(short(label(d["label"], "tn")), False, False, 0)
                    v2.pack_start(short(label(f"{d['size']} · " + (Path(d["mnt"]).name if d["mnt"] else "not mounted"), "ts")), False, False, 0)
                    r.pack_start(v2, True, True, 0)
                    if d["path"] in state["busy"]:
                        r.pack_end(label("…", "amber"), False, False, 0)
                    else:
                        def eject(d=d):
                            state["busy"].add(d["path"])
                            draw()
                            cmd = ["sh", "-c", f"udisksctl unmount -b '{d['path']}' >/dev/null 2>&1; udisksctl power-off -b '{d['parent']}'"]
                            run_then(cmd, lambda rc, err, p=d["path"], l=d["label"]: (state["busy"].discard(p),
                                     bg(["notify-send", "-a", "Drives", "Drives", f"{l} can now be removed safely." if rc == 0 else f"{l} is still in use. Close the files on it and try again."]), draw()))
                        r.pack_end(button("Eject", eject, "small amber"), False, False, 0)
                        if d["mnt"]:
                            r.pack_end(button("Open", (lambda m=d["mnt"]: (bg(["glyph-files", m]), quit_())), "small"), False, False, 0)
                        else:
                            def mount(p=d["path"]):
                                state["busy"].add(p)
                                run_then(["udisksctl", "mount", "-b", p], lambda rc, err, p=p: (state["busy"].discard(p), draw()))
                                draw()
                            r.pack_end(button("Mount", mount, "small"), False, False, 0)
                    box.pack_start(r, False, False, 0)
                body.pack_start(box, False, False, 0)

            # where the sound goes, and which microphone (like KDE)
            for kind, title, key in (("sinks", "SOUND OUTPUT", "aout"), ("sources", "MICROPHONE", "ain")):
                devs = audio_devices(kind)
                if not devs:
                    continue
                cur = next((d for d in devs if d[2]), None)
                summary = (cur[1][:26] + ("…" if len(cur[1]) > 26 else "")) if cur else ""
                if kind == "sources" and cur and cur[3]:
                    summary = "muted · " + summary
                if section(title, key, summary):
                    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                    box.get_style_context().add_class("plist")
                    for name, desc, is_def, muted in devs:
                        r = Gtk.Box(spacing=10)
                        r.get_style_context().add_class("prow")
                        nm = label(desc, "amber" if is_def else "")
                        nm.set_ellipsize(3)
                        nm.set_max_width_chars(34)
                        r.pack_start(nm, True, True, 0)
                        if is_def:
                            r.pack_end(label("● in use", "dim"), False, False, 0)
                            if kind == "sources":
                                r.pack_end(button("Unmute" if muted else "Mute",
                                                  lambda n=name: (sh(["pactl", "set-source-mute", n, "toggle"]), later(draw, 150)),
                                                  "small"), False, False, 0)
                        else:
                            def use(n=name, k=kind):
                                sh(["pactl", "set-default-sink" if k == "sinks" else "set-default-source", n])
                                if k == "sinks":       # move what is playing now too
                                    for line in sh(["pactl", "list", "short", "sink-inputs"]).splitlines():
                                        sh(["pactl", "move-sink-input", line.split()[0], n])
                                later(draw, 150)
                            r.pack_end(button("Use", use, "small"), False, False, 0)
                        box.pack_start(r, False, False, 0)
                    if kind == "sinks" and has("pavucontrol"):
                        box.pack_start(button("Volume per app…", lambda: (bg(["pavucontrol"]), quit_()), "small"), False, False, 4)
                    body.pack_start(box, False, False, 0)

            # batteries: this computer and devices (mouse, controller, headset ...)
            bats = device_batteries()
            if bats:
                def bsum(b):
                    return f"{b['name'].split()[0]} {b['pct']}%" + (" ⚡" if b["state"] == "charging" else "")
                if section("BATTERIES", "bat", " · ".join(bsum(b) for b in bats[:3])):
                    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                    box.get_style_context().add_class("plist")
                    for b in bats:
                        r = Gtk.Box(spacing=10)
                        r.get_style_context().add_class("prow")
                        r.pack_start(tile_label((b["name"][:1] or "?").upper()), False, False, 0)
                        nm = label(b["name"])
                        nm.set_ellipsize(3)
                        r.pack_start(nm, True, True, 0)
                        st = f"{b['pct']}%" + (f" · {b['state']}" if b["state"] else "")
                        r.pack_end(label(st, "amber" if b["state"] == "charging" else ("rose" if b["pct"] <= 15 else "dim")), False, False, 0)
                        box.pack_start(r, False, False, 0)
                    body.pack_start(box, False, False, 0)

            flush()

            # volume and brightness, at the bottom, in one framed box
            sliders = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            sliders.get_style_context().add_class("sliders")

            def icon_btn(icon, cb, cls="sico"):
                ib = Gtk.Button()
                ib.get_style_context().add_class(cls)
                ib.add(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR))
                ib.set_valign(Gtk.Align.CENTER)
                if cb:
                    ib.connect("clicked", lambda *_: cb())
                return ib
            v, muted = volume()
            if v is not None:
                row = Gtk.Box(spacing=8)
                mute_b = icon_btn("audio-volume-muted-symbolic" if muted else "audio-volume-high-symbolic",
                                  lambda: (sh(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"]), later(draw, 100)),
                                  "sico muted" if muted else "sico")
                mute_b.set_tooltip_text("Mute / unmute")
                row.pack_start(mute_b, False, False, 0)
                sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
                sc.set_increments(1, 5)
                sc.set_draw_value(False)
                sc.set_value(v)
                val = label("muted" if muted else f"{v}%", "dim")
                val.set_width_chars(6)
                sc.connect("value-changed", lambda s: (sh(["wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", f"{int(s.get_value())}%"]),
                                                       val.set_text(f"{int(s.get_value())}%"), osd("volume", s.get_value())))
                row.pack_start(sc, True, True, 0)
                row.pack_start(val, False, False, 0)
                sliders.pack_start(row, False, False, 0)
            br = brightness()
            if br is not None:
                row = Gtk.Box(spacing=8)
                row.pack_start(icon_btn("display-brightness-symbolic", None), False, False, 0)
                sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 5, 100, 1)
                sc.set_increments(1, 5)
                sc.set_draw_value(False)
                sc.set_value(br)
                val = label(f"{br}%", "dim")
                val.set_width_chars(6)
                sc.connect("value-changed", lambda s: (sh(["brightnessctl", "-q", "set", f"{int(s.get_value())}%"]), val.set_text(f"{int(s.get_value())}%"), osd("brightness", s.get_value())))
                row.pack_start(sc, True, True, 0)
                row.pack_start(val, False, False, 0)
                sliders.pack_start(row, False, False, 0)
            elif has("ddcutil"):
                # a desktop monitor: brightness over the cable (DDC/CI); slow, so in the background
                cur_b = ddc_brightness_cached()
                row = Gtk.Box(spacing=8)
                row.pack_start(icon_btn("display-brightness-symbolic", None), False, False, 0)
                sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
                sc.set_increments(1, 5)
                sc.set_draw_value(False)
                sc.set_value(cur_b if cur_b is not None else 100)
                val = label(f"{cur_b}%" if cur_b is not None else "…", "dim")
                val.set_width_chars(6)
                pend = {"id": 0}

                def set_ddc(s, val=val, pend=pend):
                    v = int(s.get_value())
                    val.set_text(f"{v}%")
                    osd("brightness", v)
                    if pend["id"]:
                        GLib.source_remove(pend["id"])

                    def go():
                        pend["id"] = 0
                        bg(["ddcutil", "setvcp", "10", str(v), "--noverify"])
                        try:
                            DDC_CACHE.write_text(str(v))
                        except Exception:
                            pass
                        return False
                    pend["id"] = GLib.timeout_add(350, go)
                sc.connect("value-changed", set_ddc)
                row.pack_start(sc, True, True, 0)
                row.pack_start(val, False, False, 0)
                sliders.pack_start(row, False, False, 0)

                def read_real(sc=sc, val=val):
                    v = ddc_read()
                    if v is not None:
                        GLib.idle_add(lambda: (sc.handler_block_by_func(set_ddc), sc.set_value(v), sc.handler_unblock_by_func(set_ddc), val.set_text(f"{v}%"), False)[-1])
                    else:
                        GLib.idle_add(lambda: (val.set_text("n/a") if cur_b is None else None, False)[-1])
                if not state.get("ddc_read"):
                    state["ddc_read"] = True
                    threading.Thread(target=read_real, daemon=True).start()
            if sliders.get_children():
                out_now = next((d[1] for d in audio_devices("sinks") if d[2]), "")
                if out_now:
                    ol = label("Sound from " + out_now, "dim")
                    ol.set_ellipsize(3)
                    sliders.pack_start(ol, False, False, 0)
                body.pack_start(sliders, False, False, 0)
            body.show_all()
            GLib.idle_add(fit_height)

        clear(foot)
        for txt, icon, cmd, cls in (("Settings", "emblem-system-symbolic", ["glyph-settings"], None),
                                    ("Lock", "system-lock-screen-symbolic", ["glyph-lock"], None),
                                    ("Power", "system-shutdown-symbolic", ["glyph-power"], "amber")):
            fb = Gtk.Button()
            if cls:
                fb.get_style_context().add_class(cls)
            hb = Gtk.Box(spacing=8)
            hb.set_halign(Gtk.Align.CENTER)
            hb.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU), False, False, 0)
            hb.pack_start(Gtk.Label(label=txt), False, False, 0)
            fb.add(hb)
            fb.connect("clicked", lambda *_, c=cmd: (bg(c), quit_()))
            foot.pack_start(fb, True, True, 0)
        use_cache()
        if load_saved_cache():
            draw()                       # last known state at once ...
        else:
            body.pack_start(label("…", "dim"), False, False, 0)
        busy = {"v": False}

        def refresh_async(force=False):
            """Ask the tools in the background, redraw when the answers changed."""
            if busy["v"]:
                return True
            busy["v"] = True

            def work():
                changed = refresh_cache()

                def done():
                    busy["v"] = False
                    if (changed or force) and not state["join"]:
                        draw()
                    return False
                GLib.idle_add(done)
            threading.Thread(target=work, daemon=True).start()
            return True

        def later(fn, ms=600):          # after a click: ask again, then redraw
            GLib.timeout_add(ms, lambda: (refresh_async(force=True), False)[1])
        refresh_async(force=True)
        GLib.timeout_add_seconds(5, lambda: (refresh_async(), True)[1])

    # ------------------------------------------------------------ power
    elif kind == "power":
        win.set_size_request(300, -1)
        foot.set_no_show_all(True)
        body.get_style_context().add_class("powerbody")
        armed = {"what": None, "id": 0}
        rows = [("lock", "Lock", "Ctrl+Alt+L", ["glyph-lock"], False),
                ("logout", "Log out", "back to sign in", ["glyph-shutdown", "logout"], True),
                ("sleep", "Sleep", "wake with a key", ["systemctl", "suspend"], False),
                ("restart", "Restart", "start again", ["glyph-shutdown", "restart"], True),
                ("off", "⏻  Off", "shut down", ["glyph-shutdown", "off"], True)]

        def draw():
            clear(body)
            for key, name, hint, cmd, ask in rows:
                b = Gtk.Button()
                b.get_style_context().add_class("prow2")
                if key == "off":
                    b.get_style_context().add_class("off")
                h = Gtk.Box(spacing=10)
                is_armed = armed["what"] == key
                h.pack_start(label(name if not is_armed else name + " ?", "tn" + (" amber" if key == "off" or is_armed else "")), False, False, 0)
                h.pack_end(label("click again" if is_armed else hint, "amber" if is_armed else "dim"), False, False, 0)
                b.add(h)
                if is_armed:
                    b.get_style_context().add_class("armed")

                def act(key=key, cmd=cmd, ask=ask):
                    if ask and armed["what"] != key:
                        armed["what"] = key
                        if armed["id"]:
                            GLib.source_remove(armed["id"])
                        armed["id"] = GLib.timeout_add(3000, lambda: (armed.update(what=None, id=0), draw(), False)[2])
                        draw()
                        return
                    quit_()
                    bg(cmd)
                b.connect("clicked", lambda *_, f=act: f())
                body.pack_start(b, False, False, 0)
            body.show_all()
            GLib.idle_add(fit_height)
        draw()

    # ------------------------------------------------------------ clipboard history
    elif kind == "clip":
        win.set_size_request(520, -1)
        q = Gtk.SearchEntry()
        q.set_placeholder_text("Search the clipboard…")
        body.pack_start(q, False, False, 0)
        lst = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        body.pack_start(lst, False, False, 0)
        items = []
        if has("cliphist"):
            for line in sh(["cliphist", "list"]).splitlines()[:60]:
                if "\t" in line:
                    cid, text = line.split("\t", 1)
                    items.append((cid, text))

        def paste(cid):
            # put it back on the clipboard, close, then paste into the window you were in
            subprocess.run(["sh", "-c", f"cliphist decode {cid} | wl-copy"], check=False)
            quit_()
            bg(["sh", "-c", "sleep 0.25; wtype -M ctrl -k v -m ctrl"])

        def fill(*_):
            clear(lst)
            want = q.get_text().lower()
            shown = 0
            for cid, text in items:
                if want and want not in text.lower():
                    continue
                b = Gtk.Button()
                b.get_style_context().add_class("wrow")
                l = Gtk.Label(label=("🖼 " + text) if text.startswith("[[ binary") else text.replace("\n", " ⏎ "), xalign=0)
                l.set_ellipsize(3)
                l.set_max_width_chars(60)
                b.add(l)
                b.connect("clicked", lambda *_, c=cid: paste(c))
                lst.pack_start(b, False, False, 0)
                shown += 1
                if shown >= 25:
                    break
            if not items:
                lst.pack_start(label("Nothing copied yet." if has("cliphist") else
                                     "Clipboard history needs cliphist: sudo apt install cliphist", "dim", wrap=True), False, False, 0)
            lst.show_all()
            GLib.idle_add(fit_height)
        q.connect("search-changed", fill)
        q.connect("activate", lambda *_: (lst.get_children() and lst.get_children()[0].clicked()) if items else None)
        fill()
        foot.pack_start(button("Clear history", lambda: (sh(["cliphist", "wipe"]), quit_())), True, True, 0)
        foot.pack_start(button("Close", quit_), True, True, 0)
        GLib.idle_add(q.grab_focus)

    # ------------------------------------------------------------ shortcuts
    elif kind == "keys":
        win.set_size_request(560, -1)
        g = Gtk.Grid(column_spacing=18, row_spacing=6)
        for i, (k, what) in enumerate(SHORTCUTS):
            kl = label(k, "amber")
            kl.set_xalign(1)
            g.attach(kl, 0, i, 1, 1)
            g.attach(label(what), 1, i, 1, 1)
        body.pack_start(g, False, False, 0)
        body.pack_start(label("All keys: Settings → Keyboard", "dim"), False, False, 0)
        foot.pack_start(button("Keyboard settings", lambda: (bg(["glyph-settings", "Keyboard"]), quit_())), True, True, 0)
        foot.pack_start(button("Close", quit_), True, True, 0)
        body.show_all()
        GLib.idle_add(fit_height)

    # ------------------------------------------------------------ now playing
    elif kind == "media":
        win.set_size_request(380, -1)

        def draw():
            clear(body)
            ps = media_players()
            if not ps:
                body.pack_start(label("Nothing is playing.", "dim"), False, False, 0)
            for pl, st, ti, ar in ps[:3]:
                box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                box.pack_start(label(ti or pl, "tn"), False, False, 0)
                box.pack_start(label((ar + " · " if ar else "") + pl.split(".")[0], "dim"), False, False, 0)
                row = Gtk.Box(spacing=6, homogeneous=True)
                for sym, cmd in (("⏮", "previous"), ("⏸" if st == "Playing" else "▶", "play-pause"), ("⏭", "next")):
                    b = button(sym, lambda c=cmd, p=pl: (sh(["playerctl", "-p", p, c]), later(draw, 300)))
                    row.pack_start(b, True, True, 0)
                box.pack_start(row, False, False, 4)
                body.pack_start(box, False, False, 0)
            body.show_all()
            GLib.idle_add(fit_height)
        draw()
        GLib.timeout_add_seconds(2, lambda: (draw(), True)[1])
        foot.pack_start(button("Music", lambda: (bg(["glyph-music"]), quit_())), True, True, 0)
        foot.pack_start(button("Sound settings", lambda: (bg(["glyph-settings", "Sound"]), quit_())), True, True, 0)

    # ------------------------------------------------------------ windows
    elif kind == "windows":
        win.set_size_request(400, -1)
        last = {"w": "start"}

        def draw(force=True):
            wins = open_windows()
            if not force and wins == last["w"]:
                return
            last["w"] = wins
            clear(body)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.get_style_context().add_class("ovlist")
            if wins is None:
                box.pack_start(label("The window list is not available right now.", "dim", wrap=True), False, False, 0)
            elif not wins:
                box.pack_start(label("No windows open. Press ▸ START to open an app.", "dim", wrap=True), False, False, 0)
            for app, wtitle, st in wins or []:
                name = app_name(app, wtitle)
                row = Gtk.Box()
                row.get_style_context().add_class("ovr")
                if st == "on screen":
                    row.get_style_context().add_class("act")
                go = Gtk.Button()
                go.get_style_context().add_class("ovgo")
                h = Gtk.Box(spacing=10)
                h.pack_start(tile_label(name[:1]), False, False, 0)
                v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                v.set_valign(Gtk.Align.CENTER)
                v.pack_start(label(name, "tn"), False, False, 0)
                if wtitle and wtitle != name:
                    t = label(wtitle, "ts")
                    t.set_ellipsize(3)
                    t.set_max_width_chars(34)
                    v.pack_start(t, False, False, 0)
                h.pack_start(v, True, True, 0)
                h.pack_end(label(st, "dim ovst"), False, False, 0)
                go.add(h)
                go.connect("clicked", lambda *_, a=app, t=wtitle: (window_do("focus", a, t), quit_()))
                row.pack_start(go, True, True, 0)
                xb = Gtk.Button(label="×")
                xb.get_style_context().add_class("ovx")
                xb.connect("clicked", lambda *_, a=app, t=wtitle: (window_do("close", a, t), later(draw, 400)))
                row.pack_start(xb, False, False, 0)
                box.pack_start(row, False, False, 0)
            body.pack_start(box, False, False, 0)
            body.show_all()
            GLib.idle_add(fit_height)

        def close_all():
            bg(["glyph-toplevel", "close-all"])
            quit_()
        foot.pack_start(button("▸ START", lambda: (quit_(), bg(["glyph-start"]))), True, True, 0)
        foot.pack_start(button("Close all", close_all), True, True, 0)
        draw()
        GLib.timeout_add_seconds(2, lambda: (draw(False), True)[1])

    # ------------------------------------------------------------ calendar
    else:
        win.set_size_request(360, -1)
        today = datetime.date.today()
        view = {"y": today.year, "m": today.month}

        def draw():
            clear(body)
            now = datetime.datetime.now()
            body.pack_start(label(now.strftime("%H:%M"), "bigclock", xalign=0.5), False, False, 0)
            body.pack_start(label(now.strftime("%A %d %B %Y"), "dim", xalign=0.5), False, False, 0)
            nav = Gtk.Box(spacing=6)
            nav.pack_start(button("‹", lambda: (view.update(y=view["y"] - (view["m"] == 1), m=12 if view["m"] == 1 else view["m"] - 1), draw()), "small"), False, False, 0)
            nav.pack_start(label(datetime.date(view["y"], view["m"], 1).strftime("%B %Y").upper(), "lab", xalign=0.5), True, True, 0)
            nav.pack_start(button("›", lambda: (view.update(y=view["y"] + (view["m"] == 12), m=1 if view["m"] == 12 else view["m"] + 1), draw()), "small"), False, False, 0)
            body.pack_start(nav, False, False, 0)
            g = Gtk.Grid(column_homogeneous=True, row_spacing=2, column_spacing=2)
            for i, d in enumerate(["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]):
                g.attach(label(d, "dim", xalign=0.5), i, 0, 1, 1)
            for r, week in enumerate(calendar.Calendar(0).monthdayscalendar(view["y"], view["m"])):
                for c, day in enumerate(week):
                    if day:
                        cls = "day today" if datetime.date(view["y"], view["m"], day) == today else "day"
                        g.attach(label(str(day), cls, xalign=0.5), c, r + 1, 1, 1)
            body.pack_start(g, False, False, 0)
            # notifications
            hdr = Gtk.Box(spacing=6)
            hdr.pack_start(label("NOTIFICATIONS", "lab"), True, True, 0)
            d_on = dnd_on()
            hdr.pack_start(button("DND on" if d_on else "DND off", lambda: (sh(["makoctl", "mode", "-t", "do-not-disturb"]), draw()), "small on" if d_on else "small"), False, False, 0)
            body.pack_start(hdr, False, False, 0)
            items = notif_history()
            hidden = cleared_ids()
            items = [i for i in items if str(i[0]) not in hidden][:8]
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.get_style_context().add_class("list")
            if not items:
                box.pack_start(label("No notifications.", "dim"), False, False, 0)
            for _nid, app, summ, bod in items:
                r = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
                r.get_style_context().add_class("row")
                r.pack_start(label((app.upper() + " · " if app else "") + summ, "tn"), False, False, 0)
                if bod:
                    r.pack_start(label(bod, "ts", wrap=True), False, False, 0)
                box.pack_start(r, False, False, 0)
            body.pack_start(box, False, False, 0)
            body.show_all()
            GLib.idle_add(fit_height)

        clear(foot)
        def go_today():
            view.update(y=today.year, m=today.month)
            draw()
            scroll.get_vadjustment().set_value(0)

        def clear_all():
            sh(["makoctl", "dismiss", "--all"])
            ids = cleared_ids() | {str(i[0]) for i in notif_history()}
            try:
                CLEARED.write_text(" ".join(sorted(ids)[-500:]))
            except Exception:
                pass
            draw()
        foot.pack_start(button("Today", go_today), True, True, 0)
        foot.pack_start(button("Clear", clear_all), True, True, 0)
        draw()
        GLib.timeout_add_seconds(20, lambda: (draw(), True)[1])

    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    # Leave the taskbar's process group: when the taskbar reloads (after a colour
    # change) it ends its whole group, which closed this window and every app
    # started from here.
    try:
        os.setsid()
    except Exception:
        pass
    what = sys.argv[1] if len(sys.argv) > 1 else "quick"
    if what == "status":
        status()
    elif what == "media-status":
        # the music button on the taskbar: hidden when nothing plays
        ps = media_players()
        if not ps:
            print(json.dumps({"text": "", "class": "none"}))
        else:
            pl, st, ti, ar = ps[0]
            t = (ti or pl)[:28] + ("…" if len(ti or pl) > 28 else "")
            print(json.dumps({"text": ("♪ " if st == "Playing" else "⏸ ") + t,
                              "tooltip": f"{ti}\n{ar}\n{pl} · {st.lower()}\nclick: controls · scroll: next / previous",
                              "class": st.lower()}))
    elif what in PANEL_KINDS:
        run_panel(what)
    else:
        print(__doc__)
