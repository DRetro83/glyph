#!/bin/sh
# live-config runs this at every start of the live system: the live user is
# signed in to Glyph straight away (greetd's initial_session).
# Debian's installer copies the image, not the running system, so an installed
# Glyph keeps the normal sign-in prompt.
# (no "exit" and no "set -e": live-config may read this file into its own shell)

Glyph_autologin ()
{
	grep -qw "boot=live" /proc/cmdline || return 0
	_GLYPH_USER="${LIVE_USERNAME:-}"
	if [ -z "${_GLYPH_USER}" ]; then
		_GLYPH_USER=$(sed -n 's/.*live-config\.username=\([^ ]*\).*/\1/p' /proc/cmdline)
	fi
	_GLYPH_USER="${_GLYPH_USER:-glyph}"
	_GLYPH_CONF=/etc/greetd/config.toml
	[ -f "${_GLYPH_CONF}" ] || return 0
	grep -q '^\[initial_session\]' "${_GLYPH_CONF}" && return 0
	printf '\n# live session only: sign in by itself\n[initial_session]\ncommand = "glyph-session"\nuser = "%s"\n' \
		"${_GLYPH_USER}" >> "${_GLYPH_CONF}"
}

Glyph_autologin
