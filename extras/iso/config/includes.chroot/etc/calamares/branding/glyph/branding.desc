---
# Glyph's look for Calamares (the installer). Colours: glyph-theme's dark tan palette.
# build.sh fills in @VERSION@ and copies the slides (docs/img/real) next to this file.
componentName:  glyph

welcomeStyleCalamares:   false
welcomeExpandingLogo:    false

windowExpanding:    normal
windowSize:         960px,620px
windowPlacement:    center

sidebar:    widget
navigation: widget

strings:
    productName:         Glyph
    shortProductName:    Glyph
    version:             "@VERSION@"
    shortVersion:        "@VERSION@"
    versionedName:       "Glyph @VERSION@"
    shortVersionedName:  "Glyph @VERSION@"
    # the boot entry and EFI folder stay "debian": Secure Boot's signed GRUB looks there
    bootloaderEntryName: Debian
    productUrl:          https://github.com/DRetro83/glyph
    supportUrl:          https://github.com/DRetro83/glyph/issues
    knownIssuesUrl:      https://github.com/DRetro83/glyph/issues
    releaseNotesUrl:     https://github.com/DRetro83/glyph/blob/main/CHANGELOG.md

images:
    productIcon:         "icon.png"
    productLogo:         "logo.png"
    productWelcome:      "welcome.png"

style:
    SidebarBackground:        "#1a1714"
    SidebarText:              "#a89c88"
    SidebarTextCurrent:       "#0c0b0a"
    SidebarBackgroundCurrent: "#a8957c"

slideshow:
    - "slide-windows.png"
    - "slide-start.png"
    - "slide-quick.png"
    - "slide-workspaces.png"
    - "slide-light.png"

slideshowAPI: 1
