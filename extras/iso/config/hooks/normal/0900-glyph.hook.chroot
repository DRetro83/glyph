#!/bin/sh
# Runs inside the image while it is built.
set -e

# 1. Helpers that not every Debian release has: install them when they are there
#    (the same "optional" list as install.sh, plus newer firmware package names).
for p in python3-gi-cairo gir1.2-pango-1.0 cliphist gtklock-playerctl-module pkexec qt6-wayland qtwayland5 shim-signed grub-efi-amd64-signed \
         firmware-intel-graphics firmware-intel-misc firmware-mediatek; do
  if apt-cache show "$p" >/dev/null 2>&1; then
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$p" || echo "glyph: $p could not be installed, skipped"
  else
    echo "glyph: $p is not in Debian here, skipped"
  fi
done

# The installer with everything Debian recommends for it (recommends are off
# for the rest of the image; without them Calamares misses its tools).
DEBIAN_FRONTEND=noninteractive apt-get install -y --install-recommends calamares calamares-settings-debian

# 2. labwc must be labwc-glyph, or the title bars, shadow and taskbar per
#    workspace fall back to plain labwc.
v=$(dpkg-query -W -f='${Version}' labwc)
case "$v" in
  *glyph*) echo "glyph: labwc $v" ;;
  *) echo "glyph: labwc is $v, not labwc-glyph" >&2; exit 1 ;;
esac
# keep it that way when the system is updated later
mkdir -p /etc/apt/preferences.d
cat > /etc/apt/preferences.d/glyph-labwc <<'EOF'
# Glyph: keep labwc-glyph (Debian's labwc with Glyph's patches).
# glyph-update brings newer labwc-glyph versions.
Package: labwc
Pin: version *glyph*
Pin-Priority: 1001
EOF

# 3. Sign-in and start-up look: SDDM with Glyph's sign-in screen, Glyph's GRUB
#    menu and Plymouth start-up screen (extras/boot, in the default Glyph
#    colours; build.sh puts them in /usr/lib/glyph-live/boot). The live system
#    signs in by itself (usr/lib/glyph-live/live-setup).
#    SDDM with its recommends: its X server for the sign-in screen.
DEBIAN_FRONTEND=noninteractive apt-get install -y --install-recommends sddm
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends plymouth plymouth-label
B=/usr/lib/glyph-live/boot
GLYPH_BOOT_SYSTEM=1 GLYPH_PALETTE=$B/palette.env GLYPH_BOOT_RES=1920x1080 sh $B/install-boot.sh
rm -rf "$B" /var/lib/glyph-boot
echo "glyph: GRUB settings:"; sed 's/^/    /' /etc/default/grub.d/glyph.cfg
echo "glyph: Plymouth theme: $(plymouth-set-default-theme)"
# labwc's own session is Glyph's engine without Glyph: not offered at sign-in
for f in /usr/share/wayland-sessions/labwc.desktop; do
  [ -f "$f" ] && grep -q '^NoDisplay=true' "$f" || sed -i '/^\[Desktop Entry\]/a NoDisplay=true\nHidden=true' "$f" 2>/dev/null || true
done
ls /usr/share/wayland-sessions
systemctl enable sddm.service 2>/dev/null || true
ls -l /etc/systemd/system/display-manager.service || true
systemctl set-default graphical.target

# 4. Calamares (the installer): Debian's settings, Glyph's look (branding/glyph)
CS=
for f in /etc/calamares/settings.conf /usr/share/calamares/settings.conf; do [ -f "$f" ] && { CS=$f; break; }; done
if [ -n "$CS" ]; then
  sed -i 's/^branding:.*/branding: glyph/' "$CS"
  grep -q '^branding: glyph' "$CS" || { echo "glyph: could not set Calamares' branding in $CS" >&2; exit 1; }
  mkdir -p /etc/calamares/modules
  # the live user to remove from the installed system
  printf -- '---\nusername: glyph\n' > /etc/calamares/modules/removeuser.conf
  # sign-in on the installed system: SDDM (Glyph's sign-in screen), Glyph as the session
  cat > /etc/calamares/modules/displaymanager.conf <<EOF2
---
displaymanagers:
  - sddm
defaultDesktopEnvironment:
    executable: "glyph-session"
    desktopFile: "glyph"
basicSetup: false
EOF2
  echo "glyph: Calamares settings ($CS):"; grep -v '^\s*#' "$CS" | grep -v '^\s*$' | sed 's/^/    /'
  echo "glyph: Calamares modules:"; ls /etc/calamares/modules | sed 's/^/    /'
  # Debian's own "Install Debian" launcher: hidden; "Install Glyph" takes its place in the live system
  for f in $(grep -l -i -e 'calamares' -e 'install-debian' /usr/share/applications/*.desktop 2>/dev/null); do
    sed -i '/^\[Desktop Entry\]/a NoDisplay=true' "$f"; echo "glyph: hid $f"
  done
else
  echo "glyph: no Calamares settings found" >&2; exit 1
fi

echo "glyph: hook done"
