// Glyph start-up screen, as in the design. Colours and sizes are filled in by install-boot.sh.
Window.SetBackgroundTopColor(@VIEW_RGB@);
Window.SetBackgroundBottomColor(@VIEW_RGB@);
W = Window.GetWidth(); H = Window.GetHeight();
fs = @FS@;
pics = @TEXTPICS@;   // 1: the text was drawn as pictures by install-boot.sh

if (pics) logo.image = Image("logo.png");
else logo.image = Image.Text("GLYPH", @TEXT_RGB@, 1, "IBM Plex Mono Bold " + (fs * 3));
logo.sprite = Sprite(logo.image);
logo.sprite.SetPosition(W / 2 - logo.image.GetWidth() / 2, H / 2 - fs * 6, 1);

if (pics) sub.image = Image("sub.png");
else sub.image = Image.Text("D E B I A N   1 3   ·   L A B W C", @DIM_RGB@, 1, "IBM Plex Mono " + Math.Int(fs * 0.7));
sub.sprite = Sprite(sub.image);
sub.sprite.SetPosition(W / 2 - sub.image.GetWidth() / 2, H / 2 - fs * 6 + logo.image.GetHeight() + fs / 3, 1);

// 24 blocks; the filled ones are striped like a Glyph title bar
off = Image("seg_off.png");
on = Image("seg_on.png");
n = 24;
gap = 2;
bw = off.GetWidth();
total = n * bw + (n - 1) * gap;
x0 = W / 2 - total / 2;
by = H / 2 + fs;
for (i = 0; i < n; i++) {
  seg[i] = Sprite(off);
  seg[i].SetPosition(x0 + i * (bw + gap), by, 1);
}
lit = 0;

fun progress_cb(duration, progress) {
  want = Math.Int(progress * n + 0.5);
  if (want < 1) want = 1;
  if (want > n) want = n;
  while (lit < want) {
    seg[lit].SetImage(on);
    lit++;
  }
}
Plymouth.SetBootProgressFunction(progress_cb);

if (pics) status.image = Image("starting.png");
else status.image = Image.Text("Starting …", @TAN_RGB@, 1, "IBM Plex Mono " + Math.Int(fs * 0.8));
status.sprite = Sprite(status.image);
status.sprite.SetPosition(W / 2 - status.image.GetWidth() / 2, by + off.GetHeight() + fs, 1);

if (pics) hint.image = Image("hint.png");
else hint.image = Image.Text("Esc · show details", @DIM_RGB@, 1, "IBM Plex Mono " + Math.Int(fs * 0.7));
hint.sprite = Sprite(hint.image);
hint.sprite.SetPosition(W / 2 - hint.image.GetWidth() / 2, H - fs * 2.5, 1);

fun message_cb(text) {
  img = Image.Text(text, @TAN_RGB@, 1, "IBM Plex Mono " + Math.Int(fs * 0.8));
  if (!img || img.GetWidth() < 2) return;
  status.image = img;
  status.sprite.SetImage(status.image);
  status.sprite.SetPosition(W / 2 - status.image.GetWidth() / 2, by + off.GetHeight() + fs, 1);
}
Plymouth.SetMessageFunction(message_cb);

// password prompt (encrypted disk)
fun display_password_cb(prompt, bullets) {
  s = "";
  for (i = 0; i < bullets; i++) s += "•";
  pw.image = Image.Text(prompt + "  " + s, @TEXT_RGB@, 1, "IBM Plex Mono " + fs);
  pw.sprite = Sprite(pw.image);
  pw.sprite.SetPosition(W / 2 - pw.image.GetWidth() / 2, by + off.GetHeight() + fs * 3, 3);
}
fun display_normal_cb() { pw.sprite = NULL; }
Plymouth.SetDisplayPasswordFunction(display_password_cb);
Plymouth.SetDisplayNormalFunction(display_normal_cb);
