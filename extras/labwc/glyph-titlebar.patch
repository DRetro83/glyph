+/*
+ * Glyph: a 1 pixel wide buffer with the titlebar background and fine
+ * horizontal stripes. It is stretched across the titlebar.
+ */
+static void
+create_title_stripes(struct theme *theme)
+{
+	for (int active = THEME_INACTIVE; active <= THEME_ACTIVE; active++) {
+		if (!theme->window[active].title_stripes || theme->titlebar_height <= 0) {
+			continue;
+		}
+		struct lab_data_buffer *buf =
+			buffer_create_cairo(1, theme->titlebar_height, 1.0);
+		if (!buf) {
+			wlr_log(WLR_ERROR, "Failed to allocate titlebar stripes");
+			continue;
+		}
+		cairo_t *cr = cairo_create(buf->surface);
+		float *bg = theme->window[active].title_bg_color;
+		float *st = theme->window[active].title_stripe_color;
+		cairo_set_operator(cr, CAIRO_OPERATOR_SOURCE);
+		cairo_set_source_rgba(cr, bg[0], bg[1], bg[2], bg[3]);
+		cairo_paint(cr);
+		cairo_set_source_rgba(cr, st[0], st[1], st[2], st[3]);
+		for (int y = 3; y < theme->titlebar_height - 2; y += 3) {
+			cairo_rectangle(cr, 0, y, 1, 1);
+		}
+		cairo_fill(cr);
+		cairo_destroy(cr);
+		cairo_surface_flush(buf->surface);
+		theme->window[active].title_stripes_buffer = buf;
+	}
+}
+
